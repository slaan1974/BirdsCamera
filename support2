#!/usr/bin/env bash
# ==============================================================================
# Ultralytics YOLO — Troubleshooting & Diagnostics for Team 2 (Local)
# Raspberry Pi 4 + Camera v2 — No Docker, native Pi OS
# ==============================================================================
# Usage:
#   ./support2              Run full diagnostics
#   ./support2 quick        Quick overview (system + service status only)
#   ./support2 camera       Detailed camera diagnostics (rpicam-* tools)
#   ./support2 logs         Show relevant log tails
#   ./support2 fix          Suggest fixes for detected issues
# ==============================================================================
set -euo pipefail

# ── Configuration ──────────────────────────────────────────────────────────────
PI_USER="${USER:-pi}"
HOME_DIR="/home/${PI_USER}"
BASE_DIR="${HOME_DIR}/ultralytics-local"
RESULTS_DIR="${BASE_DIR}/results"
MODELS_DIR="${BASE_DIR}/models"
MODEL_NAME="yolo26n"
SERVICE_NAME="ultralytics-local.service"
GALLERY_SERVICE_NAME="ultralytics-gallery.service"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

PASS=0
FAIL=0
WARN=0

log_passed()  { PASS=$((PASS + 1)); echo -e "  ${GREEN}✓${NC} $1"; }
log_failed()  { FAIL=$((FAIL + 1)); echo -e "  ${RED}✗${NC} $1"; }
log_warn()    { WARN=$((WARN + 1)); echo -e "  ${YELLOW}⚠${NC} $1"; }
log_info()    { echo -e "  ${CYAN}→${NC} $1"; }
log_header()  { echo -e "\n${BOLD}── $1 ──${NC}\n"; }

# ── Logging Setup ────────────────────────────────────────────────────────────
SCRIPT_NAME="support2"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOG_DIR="${SCRIPT_DIR}/logs"
mkdir -p "${LOG_DIR}"
LOG_FILE="${LOG_DIR}/$(date +%Y%m%d_%H%M%S)_${SCRIPT_NAME}.log"
exec > >(tee -a "${LOG_FILE}") 2>&1

# ── Service Management (pause/resume for camera diagnostics) ─────────────────────
SERVICE_RESTART_NEEDED=0

stop_service_for_camera() {
    if systemctl is-active --quiet "${SERVICE_NAME}" 2>/dev/null; then
        log_info "YOLO service is running — temporarily stopping for camera test..."
        sudo systemctl stop "${SERVICE_NAME}" 2>/dev/null || true
        SERVICE_RESTART_NEEDED=1
        log_info "Service stopped"
    fi
}

restart_service_after_camera() {
    if [ "${SERVICE_RESTART_NEEDED}" = "1" ]; then
        log_info "Restarting YOLO service..."
        sudo systemctl start "${SERVICE_NAME}" 2>/dev/null || true
        SERVICE_RESTART_NEEDED=0
        log_info "Service restarted"
    fi
}

trap restart_service_after_camera EXIT

# ── 1. System Information ──────────────────────────────────────────────────────
check_system() {
    log_header "System Information"

    if [ -f /etc/os-release ]; then
        . /etc/os-release
        log_passed "OS: ${PRETTY_NAME:-$NAME $VERSION}"
    else
        log_failed "Cannot detect OS"
    fi

    local arch
    arch=$(uname -m)
    if [ "$arch" = "aarch64" ] || [ "$arch" = "armv7l" ]; then
        log_passed "Architecture: ${arch} (ARM)"
    else
        log_warn "Architecture: ${arch} (expected aarch64 on Pi)"
    fi

    log_info "Kernel: $(uname -r)"
    log_info "Uptime: $(uptime -p 2>/dev/null || uptime)"

    local mem_total mem_avail mem_pct
    mem_total=$(free -m | awk '/Mem:/ {print $2}')
    mem_avail=$(free -m | awk '/Mem:/ {print $7}')
    mem_pct=$(( (mem_total - mem_avail) * 100 / mem_total ))
    if [ "$mem_pct" -gt 90 ]; then
        log_failed "Memory: ${mem_pct}% used (${mem_avail}M free of ${mem_total}M — LOW)"
    elif [ "$mem_pct" -gt 75 ]; then
        log_warn "Memory: ${mem_pct}% used (${mem_avail}M free of ${mem_total}M)"
    else
        log_passed "Memory: ${mem_pct}% used (${mem_avail}M free of ${mem_total}M)"
    fi

    local disk_use disk_pct
    disk_use=$(df -h "${HOME_DIR}" | awk 'NR==2 {print $3 " / " $2}')
    disk_pct=$(df "${HOME_DIR}" | awk 'NR==2 {print $5}' | tr -d '%')
    if [ "$disk_pct" -gt 90 ]; then
        log_failed "Disk: ${disk_use} (${disk_pct}% — LOW SPACE)"
    elif [ "$disk_pct" -gt 75 ]; then
        log_warn "Disk: ${disk_use} (${disk_pct}%)"
    else
        log_passed "Disk: ${disk_use} (${disk_pct}%)"
    fi

    if command -v vcgencmd &>/dev/null; then
        local temp
        temp=$(vcgencmd measure_temp 2>/dev/null | grep -oP '[\d.]+' || echo "")
        if [ -n "$temp" ]; then
            local temp_int=${temp%.*}
            if [ "$temp_int" -gt 80 ]; then
                log_failed "CPU temperature: ${temp}°C (HIGH — check cooling)"
            elif [ "$temp_int" -gt 70 ]; then
                log_warn "CPU temperature: ${temp}°C"
            else
                log_passed "CPU temperature: ${temp}°C"
            fi
        fi
    else
        log_info "Temperature: vcgencmd not available"
    fi

    if command -v vcgencmd &>/dev/null; then
        local throttled
        throttled=$(vcgencmd get_throttled 2>/dev/null || echo "")
        if echo "$throttled" | grep -q "0x[^0]"; then
            log_warn "Throttling detected: ${throttled} (under-voltage or frequency capping)"
        else
            log_passed "Throttling: none detected"
        fi
    fi

    local swap_total swap_used
    swap_total=$(free -m | awk '/Swap:/ {print $2}')
    swap_used=$(free -m | awk '/Swap:/ {print $3}')
    if [ "$swap_total" -eq 0 ]; then
        log_warn "Swap: disabled (may cause OOM with 1GB/2GB models)"
    else
        log_info "Swap: ${swap_used}M used of ${swap_total}M"
    fi

    if [ -f /proc/device-tree/model ]; then
        log_info "Model: $(tr -d '\0' < /proc/device-tree/model)"
    fi
}

# ── 2. Camera Check ────────────────────────────────────────────────────────────
check_camera() {
    log_header "Camera"

    local video_devs
    video_devs=$(ls /dev/video* 2>/dev/null || true)
    if [ -n "$video_devs" ]; then
        log_passed "Video devices: $(echo "$video_devs" | tr '\n' ' ')"
    else
        log_failed "No /dev/video* devices found"
        log_info "Fix: sudo raspi-config → Interface Options → Camera → Enable → Reboot"
    fi

    if [ -f /boot/config.txt ] && grep -qi "start_x=1\|camera_auto_detect=1" /boot/config.txt 2>/dev/null; then
        log_passed "Camera enabled in /boot/config.txt"
    elif [ -f /boot/firmware/config.txt ] && grep -qi "start_x=1\|camera_auto_detect=1" /boot/firmware/config.txt 2>/dev/null; then
        log_passed "Camera enabled in /boot/firmware/config.txt"
    else
        log_warn "Camera setting not found in config.txt (may use default-on Bookworm)"
    fi

    # rpicam-* tools
    if command -v rpicam-hello &>/dev/null; then
        log_passed "rpicam-hello available"
    else
        log_failed "rpicam-hello not found (install: sudo apt install rpicam-apps)"
    fi
    if command -v rpicam-jpeg &>/dev/null; then
        log_passed "rpicam-jpeg available"
    else
        log_warn "rpicam-jpeg not found (install: sudo apt install rpicam-apps)"
    fi

    # Temporarily stop service so rpicam-* tools can access the sensor
    stop_service_for_camera

    # Try rpicam-hello test (--nopreview works without display)
    if command -v rpicam-hello &>/dev/null; then
        if rpicam-hello --nopreview --timeout 1000 2>&1 | head -3 | grep -qi "available\|camera\|detected"; then
            log_passed "rpicam-hello: camera sensor detected"
        else
            # rpicam-hello prints error or exits 0 silently — capture exit code
            if rpicam-hello --nopreview --timeout 1000 &>/dev/null; then
                log_passed "rpicam-hello: camera opened successfully (no errors)"
            else
                log_failed "rpicam-hello: camera test FAILED"
                log_info "Fix: check camera connection and: sudo raspi-config → Interface → Camera"
            fi
        fi
    fi

    # Try rpicam-jpeg capture
    if command -v rpicam-jpeg &>/dev/null; then
        local jpeg_test="/tmp/support2_camera_test.jpg"
        if rpicam-jpeg --output "${jpeg_test}" --timeout 2000 --width 640 --height 480 --nopreview &>/dev/null; then
            if [ -f "${jpeg_test}" ]; then
                local jpeg_size
                jpeg_size=$(du -h "${jpeg_test}" | cut -f1)
                log_passed "rpicam-jpeg: test capture succeeded (${jpeg_size})"
                rm -f "${jpeg_test}"
            else
                log_warn "rpicam-jpeg: exited OK but no output file"
            fi
        else
            log_failed "rpicam-jpeg: test capture FAILED"
            log_info "Fix: rpicam-hello --nopreview --timeout 2000  (for detailed error)"
        fi
    fi

    # picamera2 Python import test
    if python3 -c "from picamera2 import Picamera2; print('OK')" 2>/dev/null; then
        log_passed "picamera2 Python library: importable"
    else
        log_failed "picamera2 Python library: import failed"
        log_info "Fix: sudo apt install python3-picamera2"
    fi
}

# ── 3. Service Check ───────────────────────────────────────────────────────────
check_service() {
    log_header "Systemd Service"

    if ! systemctl list-units --type=service --all 2>/dev/null | grep -q "${SERVICE_NAME}"; then
        log_failed "Service '${SERVICE_NAME}' not found"
        log_info "Fix: ./team2"
        return
    fi

    local is_active is_enabled
    is_active=$(systemctl is-active "${SERVICE_NAME}" 2>/dev/null || echo "unknown")
    is_enabled=$(systemctl is-enabled "${SERVICE_NAME}" 2>/dev/null || echo "unknown")

    if [ "$is_active" = "active" ]; then
        log_passed "Service '${SERVICE_NAME}' is active (running)"
    else
        log_failed "Service '${SERVICE_NAME}' is ${is_active}"
    fi

    if [ "$is_enabled" = "enabled" ]; then
        log_passed "Service is enabled (auto-starts on boot)"
    else
        log_warn "Service is ${is_enabled} (run: sudo systemctl enable ${SERVICE_NAME})"
    fi

    local recent_logs
    recent_logs=$(journalctl -u "${SERVICE_NAME}" --since "10 min ago" --no-pager -n 5 2>/dev/null || true)
    if [ -n "$recent_logs" ]; then
        log_info "Recent service logs (last 5 lines):"
        echo "$recent_logs" | while IFS= read -r line; do
            echo "    $line"
        done
    fi

    local restarts
    restarts=$(journalctl -u "${SERVICE_NAME}" --since "1 hour ago" --no-pager 2>/dev/null | grep -c "Started\|Starting" || true)
    if [ "$restarts" -gt 10 ]; then
        log_warn "Service restarted ${restarts} times in the last hour (possible crash loop)"
    fi

    # ── Gallery Service ──
    echo ""
    if ! systemctl list-units --type=service --all 2>/dev/null | grep -q "${GALLERY_SERVICE_NAME}"; then
        log_warn "Gallery service '${GALLERY_SERVICE_NAME}' not found (run: ./team2)"
    else
        local gactive genabled
        gactive=$(systemctl is-active "${GALLERY_SERVICE_NAME}" 2>/dev/null || echo "unknown")
        genabled=$(systemctl is-enabled "${GALLERY_SERVICE_NAME}" 2>/dev/null || echo "unknown")
        if [ "$gactive" = "active" ]; then
            log_passed "Gallery service '${GALLERY_SERVICE_NAME}' is active (running)"
        else
            log_failed "Gallery service '${GALLERY_SERVICE_NAME}' is ${gactive}"
        fi
        if [ "$genabled" = "enabled" ]; then
            log_passed "Gallery service is enabled (auto-starts on boot)"
        else
            log_warn "Gallery service is ${genabled} (run: sudo systemctl enable ${GALLERY_SERVICE_NAME})"
        fi
    fi
}

# ── 4. Model Check ─────────────────────────────────────────────────────────────
check_model() {
    log_header "YOLO Model"

    local model_dir="${MODELS_DIR}/${MODEL_NAME}_ncnn_model"

    if [ -d "$model_dir" ]; then
        log_passed "NCNN model directory exists: ${model_dir}"

        local param_file bin_file meta_file
        param_file=$(find "${model_dir}" -name "*.param" 2>/dev/null | head -1)
        bin_file=$(find "${model_dir}" -name "*.bin" 2>/dev/null | head -1)
        meta_file="${model_dir}/metadata.yaml"

        [ -n "$param_file" ] && log_passed "  param file: $(basename "$param_file") ($(du -h "$param_file" | cut -f1))" \
                              || log_failed "  missing .param file"

        [ -n "$bin_file" ] && log_passed "  bin file:   $(basename "$bin_file") ($(du -h "$bin_file" | cut -f1))" \
                            || log_failed "  missing .bin file"

        [ -f "$meta_file" ] && log_passed "  metadata.yaml present" \
                             || log_warn "  metadata.yaml missing (may still work)"
    else
        log_failed "NCNN model directory not found at ${model_dir}"
        log_info "Fix: ./team2 (exports model automatically)"
    fi

    # Check venv
    if [ -f "${BASE_DIR}/venv/bin/python3" ]; then
        log_passed "Virtual environment exists: ${BASE_DIR}/venv"
    else
        log_failed "Virtual environment not found"
        log_info "Fix: ./team2 (creates venv automatically)"
    fi

    # Check inference script
    if [ -f "${BASE_DIR}/run_yolo.py" ]; then
        log_passed "Inference script exists: ${BASE_DIR}/run_yolo.py"
    else
        log_failed "Inference script not found"
    fi

    # Check web gallery script
    if [ -f "${BASE_DIR}/web_gallery.py" ]; then
        log_passed "Web gallery script exists: ${BASE_DIR}/web_gallery.py"
    else
        log_warn "Web gallery script not found"
    fi
}

# ── 5. Results Check ───────────────────────────────────────────────────────────
check_results() {
    log_header "Detection Results"

    if [ ! -d "${RESULTS_DIR}" ]; then
        log_info "Results directory not created yet"
        return
    fi

    local n_frames n_logs
    n_frames=$(ls -1 "${RESULTS_DIR}"/detect_*.jpg 2>/dev/null | wc -l)
    n_logs=$(wc -l < "${RESULTS_DIR}/detections.jsonl" 2>/dev/null || echo "0")

    if [ "$n_frames" -gt 0 ]; then
        local latest latest_size
        latest=$(ls -1t "${RESULTS_DIR}"/detect_*.jpg 2>/dev/null | head -1)
        latest_size=$(du -h "$latest" 2>/dev/null | cut -f1)
        log_passed "Detection images: ${n_frames} saved (latest: $(basename "$latest"), ${latest_size})"
    else
        log_info "No detection images saved yet"
    fi

    if [ "$n_logs" -gt 0 ]; then
        log_passed "Detection log entries: ${n_logs}"
        log_info "Last detection:"
        tail -1 "${RESULTS_DIR}/detections.jsonl" 2>/dev/null | python3 -m json.tool 2>/dev/null || true
    else
        log_info "No detection log entries yet"
    fi

    # Gallery check
    if [ -f "${BASE_DIR}/web_gallery.py" ]; then
        if pgrep -f "web_gallery.py" &>/dev/null 2>&1; then
            log_passed "Web gallery is running (port 5000)"
        else
            log_info "Web gallery not running (start with: ./team2 gallery)"
        fi
    fi

    local data_size
    data_size=$(du -sh "${RESULTS_DIR}" 2>/dev/null | cut -f1)
    log_info "Results directory size: ${data_size}"
}

# ── 6. Network Check ───────────────────────────────────────────────────────────
# ── Data Drive Check ──────────────────────────────────────────────────────────
DATA_DRIVE_MOUNT="/mnt/wildlife-data"
DATA_DRIVE_SENTINEL=".wildlife_data_sentinel"

check_data_drive() {
    log_header "Data Drive (exFAT)"

    if mountpoint -q "${DATA_DRIVE_MOUNT}" 2>/dev/null; then
        log_passed "Mounted at ${DATA_DRIVE_MOUNT}"

        local fstype
        fstype=$(df -T "${DATA_DRIVE_MOUNT}" | awk 'NR==2 {print $2}')
        log_info "Filesystem type: ${fstype}"

        local free_space
        free_space=$(df -h "${DATA_DRIVE_MOUNT}" | awk 'NR==2 {print $4}')
        log_info "Free space: ${free_space}"

        if [ -f "${DATA_DRIVE_MOUNT}/${DATA_DRIVE_SENTINEL}" ]; then
            log_passed "Sentinel file found"
        else
            log_failed "Sentinel file '${DATA_DRIVE_SENTINEL}' missing"
            log_info "  Fix: ./setup-data-drive.sh sd"
        fi

        local n_t2
        n_t2=$(ls -1 "${DATA_DRIVE_MOUNT}/team2"/detect_*.jpg 2>/dev/null | wc -l)
        log_info "Detection files for Team 2: ${n_t2}"

        local t2_link="${HOME_DIR}/ultralytics-local/results"
        if [ -L "$t2_link" ] && [ "$(readlink "$t2_link")" = "${DATA_DRIVE_MOUNT}/team2" ]; then
            log_passed "Symlink ${t2_link} → ${DATA_DRIVE_MOUNT}/team2"
        else
            log_warn "Symlink ${t2_link} not pointing to data drive"
        fi

        if grep -q "${DATA_DRIVE_MOUNT}" /etc/fstab 2>/dev/null; then
            log_passed "fstab entry present"
        else
            log_warn "No fstab entry for ${DATA_DRIVE_MOUNT}"
        fi
    else
        log_info "Data drive not mounted at ${DATA_DRIVE_MOUNT}"
        log_info "  Set up with: ./setup-data-drive.sh sd"
    fi
}

# ── 6. Network Check ───────────────────────────────────────────────────────────
check_network() {
    log_header "Network"

    local ip_addr
    ip_addr=$(ip -4 addr show | grep -oP 'inet \K[\d.]+' | grep -v '127.0.0.1' | head -1)
    log_info "IP address: ${ip_addr:-not found}"

    if ping -c 1 -W 3 8.8.8.8 &>/dev/null; then
        log_passed "Internet reachable (8.8.8.8)"
    else
        log_warn "Internet not reachable"
    fi

    if ping -c 1 -W 3 google.com &>/dev/null; then
        log_passed "DNS resolving (google.com)"
    else
        log_warn "DNS not resolving"
    fi

    if ss -tlnp 2>/dev/null | grep -q ":5000 "; then
        log_passed "Port 5000 is listening (web gallery)"
    else
        log_info "Port 5000 not in use (web gallery not running)"
    fi
}

# ── Summary ────────────────────────────────────────────────────────────────────
print_summary() {
    local total=$((PASS + FAIL + WARN))
    echo ""
    echo "═══════════════════════ Summary ═══════════════════════"
    echo ""
    echo -e "  ${GREEN}${PASS} passed${NC}  |  ${RED}${FAIL} failed${NC}  |  ${YELLOW}${WARN} warnings${NC}  |  ${total} total checks"
    echo ""

    if [ "$FAIL" -gt 0 ]; then
        echo "  ❌ ${FAIL} issue(s) detected — review the sections above."
        echo "     Run '$0 fix' for suggested fixes."
    elif [ "$WARN" -gt 0 ]; then
        echo "  ⚠️  All critical checks passed, but ${WARN} warning(s) found."
    else
        echo "  ✅ All checks passed — system is healthy."
    fi
    echo ""
}

# ── 7. Fix Suggestions ─────────────────────────────────────────────────────────
cmd_fix() {
    echo ""
    echo "${BOLD}═ Ultralytics YOLO (Team 2) — Fix Suggestions ═${NC}"
    echo ""

    # Camera fix
    if ! ls /dev/video* &>/dev/null; then
        echo "  ${BOLD}Camera not detected:${NC}"
        echo "    sudo raspi-config  → Interface Options → Camera → Enable"
        echo "    sudo reboot"
        echo ""
    fi
    if command -v rpicam-hello &>/dev/null; then
        if ! rpicam-hello --nopreview --timeout 1000 &>/dev/null; then
            # Check if the YOLO service is holding the camera
            if systemctl is-active --quiet "${SERVICE_NAME}" 2>/dev/null; then
                echo "  ${BOLD}Camera busy — YOLO service is running:${NC}"
                echo "    The ultralytics-local.service is using the camera."
                echo "    ./support2 runs diagnostics without interference (service auto-paused)."
                echo "    To test manually: sudo systemctl stop ${SERVICE_NAME}"
                echo "    Then: rpicam-hello --nopreview --timeout 2000"
                echo "    Resume with: sudo systemctl start ${SERVICE_NAME}"
                echo ""
            fi
            echo "  ${BOLD}Camera sensor not responding:${NC}"
            echo "    sudo raspi-config  → Interface Options → Camera → Enable → Reboot"
            echo "    Check ribbon cable connection"
            echo "    rpicam-hello -t 2000  (on desktop with display for detailed errors)"
            echo ""
        fi
    fi
    if ! python3 -c "from picamera2 import Picamera2" 2>/dev/null; then
        echo "  ${BOLD}picamera2 Python library not available:${NC}"
        echo "    sudo apt update && sudo apt install python3-picamera2"
        echo ""
    fi

    # Service fix
    if systemctl list-units --type=service --all 2>/dev/null | grep -q "${SERVICE_NAME}"; then
        local is_active
        is_active=$(systemctl is-active "${SERVICE_NAME}" 2>/dev/null || echo "unknown")
        if [ "$is_active" != "active" ]; then
            echo "  ${BOLD}Service '${SERVICE_NAME}' not running:${NC}"
            echo "    sudo systemctl restart ${SERVICE_NAME}"
            echo "    sudo journalctl -fu ${SERVICE_NAME}   (watch logs)"
            echo ""
        fi
    else
        echo "  ${BOLD}Service '${SERVICE_NAME}' not found:${NC}"
        echo "    ./team2   (full setup)"
        echo ""
    fi

    # Model fix
    if [ ! -d "${MODELS_DIR}/${MODEL_NAME}_ncnn_model" ]; then
        echo "  ${BOLD}NCNN model not exported:${NC}"
        echo "    ./team2   (exports automatically if model missing)"
        echo "    # Or manually:"
        echo "    source ~/ultralytics-local/venv/bin/activate"
        echo "    yolo export model=yolo26n.pt format=ncnn imgsz=320"
        echo "    mv ~/yolo26n_ncnn_model ~/ultralytics-local/models/"
        echo ""
    fi

    # Venv fix
    if [ ! -f "${BASE_DIR}/venv/bin/python3" ]; then
        echo "  ${BOLD}Virtual environment missing:${NC}"
        echo "    python3 -m venv --system-site-packages ~/ultralytics-local/venv"
        echo "    source ~/ultralytics-local/venv/bin/activate"
        echo "    pip install -U pip && pip install ultralytics[export]"
        echo ""
    fi

    # Memory fix
    local mem_avail
    mem_avail=$(free -m | awk '/Mem:/ {print $7}')
    if [ "$mem_avail" -lt 200 ]; then
        echo "  ${BOLD}Low memory (only ${mem_avail}M available):${NC}"
        echo "    sudo dphys-swapfile swapoff"
        echo "    sudo sed -i 's/CONF_SWAPSIZE=.*/CONF_SWAPSIZE=2048/' /etc/dphys-swapfile"
        echo "    sudo dphys-swapfile setup && sudo dphys-swapfile swapon"
        echo "    # Also: use yolo26n (nano) with imgsz=320"
        echo ""
    fi

    # Temperature fix
    if command -v vcgencmd &>/dev/null; then
        local temp
        temp=$(vcgencmd measure_temp 2>/dev/null | grep -oP '[\d.]+' || echo "")
        if [ -n "$temp" ] && [ "${temp%.*}" -gt 80 ]; then
            echo "  ${BOLD}High CPU temperature (${temp}°C):${NC}"
            echo "    Ensure heatsink + fan are installed and working"
            echo "    Check: sudo raspi-config → Performance → Fan"
            echo "    Consider lowering arm_freq in /boot/firmware/config.txt"
            echo ""
        fi
    fi

    # rpicam-apps fix
    if ! command -v rpicam-hello &>/dev/null; then
        echo "  ${BOLD}rpicam-apps not installed (needed for camera testing):${NC}"
        echo "    sudo apt update && sudo apt install rpicam-apps"
        echo ""
    fi

    echo "  ${BOLD}Still having issues? Run full diagnostics:${NC}"
    echo "    ./support2            (full diagnostics)"
    echo "    ./support2 quick      (quick status overview)"
    echo "    ./team2 status        (deployment status)"
    echo "    ./team2 logs          (live inference log)"
    echo "    ./team2 camera-test   (camera hardware test)"
    echo "    ./team2 snapshot      (capture test frame)"
    echo ""
}

# ── Command: Quick Overview ────────────────────────────────────────────────────
cmd_quick() {
    echo ""
    echo "${BOLD}═ Ultralytics YOLO (Team 2) — Quick Status ═${NC}"
    echo ""

    . /etc/os-release 2>/dev/null || true
    echo "  OS: ${PRETTY_NAME:-unknown}  |  Kernel: $(uname -r)  |  Arch: $(uname -m)"
    echo "  Memory: $(free -m | awk '/Mem:/ {print $3 "/" $2 "M used"}')  |  Disk: $(df -h "${HOME_DIR}" | awk 'NR==2 {print $3 "/" $2 " (" $5 ")"}')"
    if command -v vcgencmd &>/dev/null; then
        echo "  CPU: $(vcgencmd measure_temp 2>/dev/null || echo "?")  |  $(vcgencmd get_throttled 2>/dev/null || echo "")"
    fi
    echo ""

    # Camera
    video_devs=$(ls /dev/video* 2>/dev/null || true)
    echo "  Camera: $([ -n "$video_devs" ] && echo "✓ $(echo "$video_devs" | wc -w) device(s)" || echo "✗ not detected")"
    if command -v rpicam-hello &>/dev/null; then
        echo "  rpicam-hello: ✓ available"
    else
        echo "  rpicam-hello: ✗ not installed"
    fi
    echo ""

    # Service
    if systemctl list-units --type=service --all 2>/dev/null | grep -q "${SERVICE_NAME}"; then
        echo "  Service: $(systemctl is-active "${SERVICE_NAME}" 2>/dev/null) | $(systemctl is-enabled "${SERVICE_NAME}" 2>/dev/null)"
    else
        echo "  Service: ✗ not found"
    fi
    echo ""

    # Results
    n_frames=$(ls -1 "${RESULTS_DIR}"/detect_*.jpg 2>/dev/null | wc -l)
    n_logs=$(wc -l < "${RESULTS_DIR}/detections.jsonl" 2>/dev/null || echo "0")
    echo "  Results: ${n_frames} image(s), ${n_logs} detection log(s)"
    data_size=$(du -sh "${RESULTS_DIR}" 2>/dev/null | cut -f1)
    echo "  Data size: ${data_size:-not created}"
    echo ""
}

# ── Command: Show Log Tails ────────────────────────────────────────────────────
cmd_logs() {
    echo ""
    echo "${BOLD}═ Service Logs (last 30 lines) ═${NC}"
    echo ""
    sudo journalctl -u "${SERVICE_NAME}" --no-pager -n 30 2>/dev/null || echo "  (no logs)"
    echo ""
    echo "${BOLD}═ Detection Log (last 5 entries) ═${NC}"
    echo ""
    if [ -f "${RESULTS_DIR}/detections.jsonl" ]; then
        tail -5 "${RESULTS_DIR}/detections.jsonl" 2>/dev/null || true
    else
        echo "  (no detections yet)"
    fi
    echo ""
}

# ── Main ───────────────────────────────────────────────────────────────────────
usage() {
    echo "Usage: $0 [command]"
    echo ""
    echo "Commands:"
    echo "  (none)    Full diagnostics (all checks)"
    echo "  quick     Quick status overview"
    echo "  camera    Detailed camera diagnostics (rpicam-* tools)"
    echo "  datadrive Data drive health check"
    echo "  logs      Show relevant log tails"
    echo "  fix       Suggest fixes for detected issues"
    echo "  --help    Show this help"
}

case "${1:-all}" in
    all)
        echo ""
        echo "  ╔═══════════════════════════════════════════════╗"
        echo "  ║  Ultralytics YOLO  —  Diagnostics (Team 2)   ║"
        echo "  ║  Local (no Docker) — Pi 4 + Camera v2        ║"
        echo "  ╚═══════════════════════════════════════════════╝"
        echo ""
        echo "  ┌───────────────────────────────────────────────────┐"
        echo "  │  Available commands:                              │"
        echo "  │    $(printf "%-37s" "./support2         → full diagnostics") │"
        echo "  │    $(printf "%-37s" "./support2 quick   → quick overview") │"
        echo "  │    $(printf "%-37s" "./support2 camera  → camera test") │"
        echo "  │    $(printf "%-37s" "./support2 datadrive→ data drive check") │"
        echo "  │    $(printf "%-37s" "./support2 logs    → log tails") │"
        echo "  │    $(printf "%-37s" "./support2 fix     → suggested fixes") │"
        echo "  │    $(printf "%-37s" "./support2 --help  → all commands") │"
        echo "  └───────────────────────────────────────────────────┘"
        echo ""
        echo "  Timestamp: $(date)"
        echo "  User: ${PI_USER}  |  Host: $(hostname)"
        echo ""
        check_system
        check_camera
        check_service
        check_model
        check_results
        check_data_drive
        check_network
        print_summary
        ;;
    quick)
        cmd_quick
        ;;
    camera)
        check_camera
        # Extra: try a test capture via rpicam-jpeg
        # Service was already stopped inside check_camera and restarted via EXIT trap,
        # but stop it again here in case check_camera wasn't called (direct camera command).
        stop_service_for_camera
        if command -v rpicam-jpeg &>/dev/null; then
            echo ""
            log_info "Attempting test capture via rpicam-jpeg..."
            if rpicam-jpeg --output /tmp/support2_capture.jpg --timeout 2000 --width 640 --height 480 --nopreview 2>&1; then
                if [ -f /tmp/support2_capture.jpg ]; then
                    log_passed "Test capture saved to /tmp/support2_capture.jpg"
                else
                    log_failed "Test capture did not produce output file"
                fi
            else
                log_failed "Test capture command failed"
            fi
        fi
        ;;
    datadrive)
        check_data_drive
        ;;
    logs)
        cmd_logs
        ;;
    fix)
        cmd_fix
        ;;
    --help|-h)
        usage
        ;;
    *)
        echo "Unknown command: $1"
        usage
        exit 1
        ;;
esac
