#!/usr/bin/env bash
# ==============================================================================
# Ultralytics YOLO — Troubleshooting & Diagnostics Script
# Raspberry Pi 4 + Camera v2 + Team 1 (Docker) or Team 2 (Local)
# ==============================================================================
# Usage:
#   ./support              Run full diagnostics
#   ./support quick        Quick overview (system + service status only)
#   ./support camera       Detailed camera diagnostics
#   ./support docker       Docker-specific diagnostics
#   ./support logs         Show relevant log tails
#   ./support fix          Suggest fixes for detected issues
# ==============================================================================
set -euo pipefail

# ── Configuration ──────────────────────────────────────────────────────────────
USER="slaan1974"
HOME_DIR="/home/${USER}"
RESULTS_DIR="${HOME_DIR}/ultralytics/data"
CONTAINER_NAME="ultralytics-pi-cam"
SERVICE_NAME="ultralytics-docker.service"
IMAGE="ultralytics/ultralytics:latest-arm64"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

PASS=0
FAIL=0
WARN=0

log_passed()  { PASS=$((PASS + 1)); echo -e "  ${GREEN}✓${NC} $1"; }
log_failed()  { FAIL=$((FAIL + 1)); echo -e "  ${RED}✗${NC} $1"; }
log_warn()    { WARN=$((WARN + 1)); echo -e "  ${YELLOW}⚠${NC} $1"; }
log_info()    { echo -e "  ${CYAN}→${NC} $1"; }
log_header()  { echo -e "\n${BOLD}── $1 ──${NC}\n"; }

# ── Logging Setup ────────────────────────────────────────────────────────────
SCRIPT_NAME="support"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOG_DIR="${SCRIPT_DIR}/logs"
mkdir -p "${LOG_DIR}"
LOG_FILE="${LOG_DIR}/$(date +%Y%m%d_%H%M%S)_${SCRIPT_NAME}.log"
exec > >(tee -a "${LOG_FILE}") 2>&1

# ── 1. System Information ──────────────────────────────────────────────────────
check_system() {
    log_header "System Information"

    # OS
    if [ -f /etc/os-release ]; then
        . /etc/os-release
        log_passed "OS: ${PRETTY_NAME:-$NAME $VERSION}"
    else
        log_failed "Cannot detect OS"
    fi

    # Architecture
    local arch
    arch=$(uname -m)
    if [ "$arch" = "aarch64" ] || [ "$arch" = "armv7l" ]; then
        log_passed "Architecture: ${arch} (ARM)"
    else
        log_warn "Architecture: ${arch} (expected aarch64 on Pi)"
    fi

    # Kernel
    log_info "Kernel: $(uname -r)"

    # Uptime
    log_info "Uptime: $(uptime -p 2>/dev/null || uptime)"

    # Memory
    local mem_total mem_avail mem_pct
    mem_total=$(free -m | awk '/Mem:/ {print $2}')
    mem_avail=$(free -m | awk '/Mem:/ {print $7}')
    mem_pct=$(( (mem_total - mem_avail) * 100 / mem_total ))
    if [ "$mem_pct" -gt 90 ]; then
        log_failed "Memory: ${mem_pct}% used (${mem_avail}M free of ${mem_total}M — LOW)"
    elif [ "$mem_pct" -gt 75 ]; then
        log_warn "Memory: ${mem_pct}% used (${mem_avail}M free of ${mem_total}M)"
    else
        log_passed "Memory: ${mem_pct}% used (${mem_avail}M free of ${mem_total}M)"
    fi

    # Disk
    local disk_use disk_pct
    disk_use=$(df -h "${HOME_DIR}" | awk 'NR==2 {print $3 " / " $2}')
    disk_pct=$(df "${HOME_DIR}" | awk 'NR==2 {print $5}' | tr -d '%')
    if [ "$disk_pct" -gt 90 ]; then
        log_failed "Disk: ${disk_use} (${disk_pct}% — LOW SPACE)"
    elif [ "$disk_pct" -gt 75 ]; then
        log_warn "Disk: ${disk_use} (${disk_pct}%)"
    else
        log_passed "Disk: ${disk_use} (${disk_pct}%)"
    fi

    # Temperature
    if command -v vcgencmd &>/dev/null; then
        local temp
        temp=$(vcgencmd measure_temp 2>/dev/null | grep -oP '[\d.]+' || echo "")
        if [ -n "$temp" ]; then
            local temp_int=${temp%.*}
            if [ "$temp_int" -gt 80 ]; then
                log_failed "CPU temperature: ${temp}°C (HIGH — check cooling)"
            elif [ "$temp_int" -gt 70 ]; then
                log_warn "CPU temperature: ${temp}°C"
            else
                log_passed "CPU temperature: ${temp}°C"
            fi
        fi
    else
        log_info "Temperature: vcgencmd not available"
    fi

    # Throttling
    if command -v vcgencmd &>/dev/null; then
        local throttled
        throttled=$(vcgencmd get_throttled 2>/dev/null || echo "")
        if echo "$throttled" | grep -q "0x[^0]"; then
            log_warn "Throttling detected: ${throttled} (under-voltage or frequency capping)"
        else
            log_passed "Throttling: none detected"
        fi
    fi

    # Swap
    local swap_total swap_used
    swap_total=$(free -m | awk '/Swap:/ {print $2}')
    swap_used=$(free -m | awk '/Swap:/ {print $3}')
    if [ "$swap_total" -eq 0 ]; then
        log_warn "Swap: disabled (may cause OOM with 1GB/2GB models)"
    else
        log_info "Swap: ${swap_used}M used of ${swap_total}M"
    fi

    # Pi model
    if [ -f /proc/device-tree/model ]; then
        log_info "Model: $(tr -d '\0' < /proc/device-tree/model)"
    fi
}

# ── 2. Camera Check ────────────────────────────────────────────────────────────
check_camera() {
    log_header "Camera"

    # Video devices on host
    local video_devs
    video_devs=$(ls /dev/video* 2>/dev/null || true)
    if [ -n "$video_devs" ]; then
        log_passed "Host video devices: $(echo "$video_devs" | tr '\n' ' ')"
    else
        log_failed "No /dev/video* devices on host"
        log_info "Fix: sudo raspi-config → Interface Options → Camera → Enable → Reboot"
    fi

    # Camera enabled in config
    if [ -f /boot/config.txt ] && grep -qi "start_x=1\|camera_auto_detect=1" /boot/config.txt 2>/dev/null; then
        log_passed "Camera enabled in /boot/config.txt"
    elif [ -f /boot/firmware/config.txt ] && grep -qi "start_x=1\|camera_auto_detect=1" /boot/firmware/config.txt 2>/dev/null; then
        log_passed "Camera enabled in /boot/firmware/config.txt"
    else
        log_warn "Camera setting not found in config.txt (may use default-on Bookworm)"
    fi

    # Camera test tool
    if command -v rpicam-hello &>/dev/null; then
        log_info "rpicam-hello available — run 'rpicam-hello -t 2000' to test camera directly"
    elif command -v libcamera-hello &>/dev/null; then
        log_info "libcamera-hello available — run 'libcamera-hello -t 2000' to test camera directly"
    else
        log_warn "No camera test tool found (install: sudo apt install rpicam-apps)"
    fi

    # Camera inside container
    if docker ps --format '{{.Names}}' 2>/dev/null | grep -q "${CONTAINER_NAME}"; then
        local container_video
        container_video=$(docker exec "${CONTAINER_NAME}" ls /dev/video* 2>/dev/null || true)
        if [ -n "$container_video" ]; then
            log_passed "Container video devices: $(echo "$container_video" | tr '\n' ' ')"
        else
            log_failed "No video devices inside container"
            log_info "Fix: ./team1 (recreates container with current video devices)"
        fi
    fi

    # Check camera via OpenCV V4L2 inside container
    if docker ps --format '{{.Names}}' 2>/dev/null | grep -q "${CONTAINER_NAME}"; then
        if docker exec "${CONTAINER_NAME}" python3 -c "
import cv2, os
for dev in range(4):
    path = f'/dev/video{dev}'
    if os.path.exists(path):
        cap = cv2.VideoCapture(path, cv2.CAP_V4L2)
        if cap.isOpened():
            ret, frame = cap.read()
            cap.release()
            if ret and frame is not None and frame.size > 0:
                print(f'OK (device {path})')
                break
" 2>/dev/null; then
            log_passed "Camera accessible via OpenCV V4L2 in container"
        else
            log_failed "Camera not accessible in container via V4L2"
            log_info "Fix: ./team1 (recreates container with correct device mapping)"
        fi
        # Check for stale picamera2 install that blocks the V4L2 fallback
        if docker exec "${CONTAINER_NAME}" python3 -c "import picamera2" 2>/dev/null; then
            log_warn "picamera2 is installed but will crash at runtime (missing libcamera)"
            log_info "Fix: docker exec ${CONTAINER_NAME} pip uninstall -y picamera2"
        fi
    fi
}

# ── 3. Docker Check ────────────────────────────────────────────────────────────
check_docker() {
    log_header "Docker"

    # Docker installed
    if command -v docker &>/dev/null; then
        log_passed "Docker installed: $(docker --version 2>/dev/null)"
    else
        log_failed "Docker not installed"
        log_info "Fix: curl -fsSL https://get.docker.com | sh && sudo usermod -aG docker ${USER}"
        return
    fi

    # Docker daemon running
    if docker info &>/dev/null; then
        log_passed "Docker daemon running"
    else
        log_failed "Docker daemon not running or permission denied"
        log_info "Fix: sudo systemctl start docker && sudo usermod -aG docker ${USER} (then log out/back in)"
        return
    fi

    # Image pulled
    if docker image inspect "${IMAGE}" &>/dev/null; then
        local img_size
        img_size=$(docker image inspect "${IMAGE}" --format '{{.Size}}' | numfmt --to=iec 2>/dev/null || echo "")
        log_passed "Image '${IMAGE}' pulled${img_size:+ (${img_size})}"
    else
        log_failed "Image '${IMAGE}' not pulled"
        log_info "Fix: docker pull ${IMAGE}"
    fi

    # Container exists
    if docker ps -a --format '{{.Names}}' 2>/dev/null | grep -q "${CONTAINER_NAME}"; then
        local cstate
        cstate=$(docker ps -a --filter "name=${CONTAINER_NAME}" --format '{{.Status}}')
        log_passed "Container '${CONTAINER_NAME}': ${cstate}"
    else
        log_failed "Container '${CONTAINER_NAME}' does not exist"
        log_info "Fix: ./team1"
        return
    fi

    # Container running
    if docker ps --format '{{.Names}}' 2>/dev/null | grep -q "${CONTAINER_NAME}"; then
        log_passed "Container is running"

        # Resource usage
        local cpu_usage mem_usage
        cpu_usage=$(docker stats "${CONTAINER_NAME}" --no-stream --format '{{.CPUPerc}}' 2>/dev/null || echo "?")
        mem_usage=$(docker stats "${CONTAINER_NAME}" --no-stream --format '{{.MemUsage}}' 2>/dev/null || echo "?")
        log_info "Container CPU: ${cpu_usage}  |  Memory: ${mem_usage}"
    else
        log_failed "Container is not running (state: $(docker ps -a --filter "name=${CONTAINER_NAME}" --format '{{.Status}}'))"
    fi

    # Recent container logs
    local crash_count
    crash_count=$(docker logs "${CONTAINER_NAME}" 2>&1 | grep -c "Traceback\|Error\|Exception" || true)
    if [ "$crash_count" -gt 0 ]; then
        log_warn "${crash_count} error(s) in recent container logs"
    fi
}

# ── 4. Service Check ───────────────────────────────────────────────────────────
check_service() {
    log_header "Systemd Service"

    if ! systemctl list-units --type=service --all 2>/dev/null | grep -q "${SERVICE_NAME}"; then
        log_failed "Service '${SERVICE_NAME}' not found"
        log_info "Fix: sudo ./team1"
        return
    fi

    local is_active is_enabled
    is_active=$(systemctl is-active "${SERVICE_NAME}" 2>/dev/null || echo "unknown")
    is_enabled=$(systemctl is-enabled "${SERVICE_NAME}" 2>/dev/null || echo "unknown")

    if [ "$is_active" = "active" ]; then
        log_passed "Service '${SERVICE_NAME}' is active (running)"
    else
        log_failed "Service '${SERVICE_NAME}' is ${is_active}"
    fi

    if [ "$is_enabled" = "enabled" ]; then
        log_passed "Service is enabled (auto-starts on boot)"
    else
        log_warn "Service is ${is_enabled} (run: sudo systemctl enable ${SERVICE_NAME})"
    fi

    # Last few log lines
    local recent_logs
    recent_logs=$(journalctl -u "${SERVICE_NAME}" --since "10 min ago" --no-pager -n 5 2>/dev/null || true)
    if [ -n "$recent_logs" ]; then
        log_info "Recent service logs (last 5 lines):"
        echo "$recent_logs" | while IFS= read -r line; do
            echo "    $line"
        done
    fi

    # Check for restarts
    local restarts
    restarts=$(journalctl -u "${SERVICE_NAME}" --since "1 hour ago" --no-pager 2>/dev/null | grep -c "Started\|Starting" || true)
    if [ "$restarts" -gt 10 ]; then
        log_warn "Service restarted ${restarts} times in the last hour (possible crash loop)"
    fi
}

# ── 5. Model Check ─────────────────────────────────────────────────────────────
check_model() {
    log_header "YOLO Model"

    local model_dir="${RESULTS_DIR}/yolo26n_ncnn_model"

    if [ -d "$model_dir" ]; then
        log_passed "NCNN model directory exists: ${model_dir}"

        local param_file bin_file meta_file
        param_file=$(find "${model_dir}" -name "*.param" 2>/dev/null | head -1)
        bin_file=$(find "${model_dir}" -name "*.bin" 2>/dev/null | head -1)
        meta_file="${model_dir}/metadata.yaml"

        [ -n "$param_file" ] && log_passed "  param file: $(basename "$param_file") ($(du -h "$param_file" | cut -f1))" \
                              || log_failed "  missing .param file"

        [ -n "$bin_file" ] && log_passed "  bin file:   $(basename "$bin_file") ($(du -h "$bin_file" | cut -f1))" \
                            || log_failed "  missing .bin file"

        [ -f "$meta_file" ] && log_passed "  metadata.yaml present" \
                             || log_warn "  metadata.yaml missing (may still work)"
    else
        log_failed "NCNN model directory not found"
        log_info "Fix: run ./team1 (exports model) or manually: yolo export model=yolo26n.pt format=ncnn"
    fi

    # Check inference script
    if [ -f "${RESULTS_DIR}/run_yolo.py" ]; then
        log_passed "Inference script exists: ${RESULTS_DIR}/run_yolo.py"
    else
        log_failed "Inference script not found"
    fi
}

# ── 6. Results Check ───────────────────────────────────────────────────────────
check_results() {
    log_header "Detection Results"

    if [ ! -d "${RESULTS_DIR}" ]; then
        log_info "Results directory not created yet"
        return
    fi

    local n_frames n_logs
    n_frames=$(ls -1 "${RESULTS_DIR}"/detect_*.jpg 2>/dev/null | wc -l)
    n_logs=$(wc -l < "${RESULTS_DIR}/detections.jsonl" 2>/dev/null || echo "0")

    if [ "$n_frames" -gt 0 ]; then
        local latest latest_size
        latest=$(ls -1t "${RESULTS_DIR}"/detect_*.jpg 2>/dev/null | head -1)
        latest_size=$(du -h "$latest" 2>/dev/null | cut -f1)
        log_passed "Detection images: ${n_frames} saved (latest: $(basename "$latest"), ${latest_size})"
    else
        log_info "No detection images saved yet"
    fi

    if [ "$n_logs" -gt 0 ]; then
        log_passed "Detection log entries: ${n_logs}"
        log_info "Last detection:"
        tail -1 "${RESULTS_DIR}/detections.jsonl" 2>/dev/null | python3 -m json.tool 2>/dev/null || true
    else
        log_info "No detection log entries yet"
    fi

    # Gallery script
    if [ -f "${RESULTS_DIR}/web_gallery.py" ]; then
        log_passed "Web gallery script exists"
        # Check if gallery is running
        if docker exec "${CONTAINER_NAME}" sh -c "ps aux | grep -v grep | grep web_gallery" &>/dev/null 2>&1; then
            log_passed "Web gallery is running (port 5000)"
        else
            log_info "Web gallery not running (start with: ./team1 gallery)"
        fi
    fi

    # Disk usage
    local data_size
    data_size=$(du -sh "${RESULTS_DIR}" 2>/dev/null | cut -f1)
    log_info "Data directory size: ${data_size}"
}

# ── 7. Network Check ───────────────────────────────────────────────────────────
# ── Data Drive Check ──────────────────────────────────────────────────────────
DATA_DRIVE_MOUNT="/mnt/wildlife-data"
DATA_DRIVE_SENTINEL=".wildlife_data_sentinel"

check_data_drive() {
    log_header "Data Drive (exFAT)"

    if mountpoint -q "${DATA_DRIVE_MOUNT}" 2>/dev/null; then
        log_passed "Mounted at ${DATA_DRIVE_MOUNT}"

        local fstype
        fstype=$(df -T "${DATA_DRIVE_MOUNT}" | awk 'NR==2 {print $2}')
        log_info "Filesystem type: ${fstype}"

        local free_space
        free_space=$(df -h "${DATA_DRIVE_MOUNT}" | awk 'NR==2 {print $4}')
        log_info "Free space: ${free_space}"

        if [ -f "${DATA_DRIVE_MOUNT}/${DATA_DRIVE_SENTINEL}" ]; then
            log_passed "Sentinel file found"
        else
            log_failed "Sentinel file '${DATA_DRIVE_SENTINEL}' missing"
            log_info "  Fix: ./setup-data-drive.sh sd"
        fi

        local n_t1 n_t2
        n_t1=$(ls -1 "${DATA_DRIVE_MOUNT}/team1"/detect_*.jpg 2>/dev/null | wc -l)
        n_t2=$(ls -1 "${DATA_DRIVE_MOUNT}/team2"/detect_*.jpg 2>/dev/null | wc -l)
        log_info "Detection files — Team 1: ${n_t1}  Team 2: ${n_t2}"

        # Check symlinks
        local t1_link="${HOME_DIR}/ultralytics/data"
        local t2_link="${HOME_DIR}/ultralytics-local/results"
        if [ -L "$t1_link" ] && [ "$(readlink "$t1_link")" = "${DATA_DRIVE_MOUNT}/team1" ]; then
            log_passed "Symlink ${t1_link} → ${DATA_DRIVE_MOUNT}/team1"
        else
            log_warn "Symlink ${t1_link} not pointing to data drive"
        fi
        if [ -L "$t2_link" ] && [ "$(readlink "$t2_link")" = "${DATA_DRIVE_MOUNT}/team2" ]; then
            log_passed "Symlink ${t2_link} → ${DATA_DRIVE_MOUNT}/team2"
        else
            log_warn "Symlink ${t2_link} not pointing to data drive"
        fi

        # Check fstab entry
        if grep -q "${DATA_DRIVE_MOUNT}" /etc/fstab 2>/dev/null; then
            log_passed "fstab entry present"
        else
            log_warn "No fstab entry for ${DATA_DRIVE_MOUNT}"
        fi
    else
        log_info "Data drive not mounted at ${DATA_DRIVE_MOUNT}"
        log_info "  Set up with: ./setup-data-drive.sh sd"
    fi
}

# ── 7. Network Check ───────────────────────────────────────────────────────────
check_network() {
    log_header "Network"

    # Internet
    local ip_addr
    ip_addr=$(ip -4 addr show | grep -oP 'inet \K[\d.]+' | grep -v '127.0.0.1' | head -1)
    log_info "IP address: ${ip_addr:-not found}"

    if ping -c 1 -W 3 8.8.8.8 &>/dev/null; then
        log_passed "Internet reachable (8.8.8.8)"
    else
        log_warn "Internet not reachable"
    fi

    if ping -c 1 -W 3 google.com &>/dev/null; then
        log_passed "DNS resolving (google.com)"
    else
        log_warn "DNS not resolving"
    fi

    # Port 5000 (gallery)
    if ss -tlnp 2>/dev/null | grep -q ":5000 "; then
        log_passed "Port 5000 is listening (web gallery)"
    else
        log_info "Port 5000 not in use (web gallery not running)"
    fi

    # Port 8888 (TCP stream, if used)
    if ss -tlnp 2>/dev/null | grep -q ":8888 "; then
        log_info "Port 8888 is listening (rpicam-vid stream)"
    fi
}

# ── Summary ────────────────────────────────────────────────────────────────────
print_summary() {
    local total=$((PASS + FAIL + WARN))
    echo ""
    echo "═══════════════════════ Summary ═══════════════════════"
    echo ""
    echo -e "  ${GREEN}${PASS} passed${NC}  |  ${RED}${FAIL} failed${NC}  |  ${YELLOW}${WARN} warnings${NC}  |  ${total} total checks"
    echo ""

    if [ "$FAIL" -gt 0 ]; then
        echo "  ❌ ${FAIL} issue(s) detected — review the sections above."
        echo "     Run '$0 fix' for suggested fixes."
    elif [ "$WARN" -gt 0 ]; then
        echo "  ⚠️  All critical checks passed, but ${WARN} warning(s) found."
    else
        echo "  ✅ All checks passed — system is healthy."
    fi
    echo ""
}

# ── 8. Fix Suggestions ─────────────────────────────────────────────────────────
cmd_fix() {
    echo ""
    echo "${BOLD}═ Ultralytics YOLO — Fix Suggestions ═${NC}"
    echo ""

    # Camera fix
    if ! ls /dev/video* &>/dev/null; then
        echo "  ${BOLD}Camera not detected:${NC}"
        echo "    sudo raspi-config  → Interface Options → Camera → Enable"
        echo "    sudo reboot"
        echo ""
    fi
    if docker ps --format '{{.Names}}' 2>/dev/null | grep -q "${CONTAINER_NAME}"; then
        if docker exec "${CONTAINER_NAME}" python3 -c "import picamera2" 2>/dev/null; then
            echo "  ${BOLD}Stale picamera2 installation detected (crashes without libcamera):${NC}"
            echo "    docker exec ${CONTAINER_NAME} pip uninstall -y picamera2"
            echo ""
        fi
        if ! docker exec "${CONTAINER_NAME}" python3 -c "import cv2; cap=cv2.VideoCapture(0); cap.read()" 2>/dev/null; then
            echo "  ${BOLD}Camera not accessible in container via V4L2:${NC}"
            echo "    ./team1   (recreates container with correct device mapping)"
            echo ""
        fi
    fi

    # Docker fix
    if ! command -v docker &>/dev/null; then
        echo "  ${BOLD}Docker not installed:${NC}"
        echo "    curl -fsSL https://get.docker.com | sh"
        echo "    sudo usermod -aG docker ${USER}"
        echo "    # Log out and back in, or: newgrp docker"
        echo ""
    fi

    if command -v docker &>/dev/null && ! docker info &>/dev/null; then
        echo "  ${BOLD}Docker daemon not reachable:${NC}"
        echo "    sudo systemctl enable docker && sudo systemctl start docker"
        echo "    # If permission denied: sudo usermod -aG docker ${USER} && log out/back in"
        echo ""
    fi

    # Container fix
    if ! docker ps -a --format '{{.Names}}' 2>/dev/null | grep -q "${CONTAINER_NAME}"; then
        echo "  ${BOLD}Container '${CONTAINER_NAME}' missing:${NC}"
        echo "    ./team1   (full setup)"
        echo ""
    elif ! docker ps --format '{{.Names}}' 2>/dev/null | grep -q "${CONTAINER_NAME}"; then
        echo "  ${BOLD}Container exists but is not running:${NC}"
        echo "    docker start ${CONTAINER_NAME}"
        echo "    sudo systemctl start ${SERVICE_NAME}"
        echo ""
    fi

    # Service fix
    if systemctl list-units --type=service --all 2>/dev/null | grep -q "${SERVICE_NAME}"; then
        local is_active
        is_active=$(systemctl is-active "${SERVICE_NAME}" 2>/dev/null || echo "unknown")
        if [ "$is_active" != "active" ]; then
            echo "  ${BOLD}Service '${SERVICE_NAME}' not running:${NC}"
            echo "    sudo systemctl restart ${SERVICE_NAME}"
            echo "    sudo journalctl -fu ${SERVICE_NAME}   (watch logs)"
            echo ""
        fi
    fi

    # Model fix
    if [ ! -d "${RESULTS_DIR}/yolo26n_ncnn_model" ]; then
        echo "  ${BOLD}NCNN model not exported:${NC}"
        echo "    ./team1   (exports automatically if model missing)"
        echo "    # Or manually: docker run --rm -v ${RESULTS_DIR}:/data ${IMAGE} sh -c 'yolo export model=yolo26n.pt format=ncnn && cp -r yolo26n_ncnn_model /data/'"
        echo ""
    fi

    # Memory fix
    local mem_avail mem_pct
    mem_avail=$(free -m | awk '/Mem:/ {print $7}')
    mem_pct=$(( (mem_avail) * 100 / $(free -m | awk '/Mem:/ {print $2}') ))
    if [ "$mem_pct" -lt 10 ]; then
        echo "  ${BOLD}Low memory (only ${mem_avail}M available):${NC}"
        echo "    sudo dphys-swapfile swapoff"
        echo "    sudo sed -i 's/CONF_SWAPSIZE=.*/CONF_SWAPSIZE=2048/' /etc/dphys-swapfile"
        echo "    sudo dphys-swapfile setup && sudo dphys-swapfile swapon"
        echo "    # Also consider: imgsz=320 and yolo26n (nano) model only"
        echo ""
    fi

    # Temperature fix
    if command -v vcgencmd &>/dev/null; then
        local temp
        temp=$(vcgencmd measure_temp 2>/dev/null | grep -oP '[\d.]+' || echo "")
        if [ -n "$temp" ] && [ "${temp%.*}" -gt 80 ]; then
            echo "  ${BOLD}High CPU temperature (${temp}°C):${NC}"
            echo "    Ensure heatsink + fan are installed and working"
            echo "    Check: sudo raspi-config → Performance → Fan"
            echo "    Consider lowering arm_freq in /boot/firmware/config.txt"
            echo ""
        fi
    fi

    # Generic: re-run setup
    echo "  ${BOLD}Still having issues? Run full diagnostics:${NC}"
    echo "    ./support            (full diagnostics)"
    echo "    ./support quick      (quick status overview)"
    echo "    ./team1 status       (deployment status)"
    echo "    ./team1 logs         (live inference log)"
    echo ""

    # If all seems OK
    echo "  ${BOLD}If everything looks fine but nothing seems to work:${NC}"
    echo "    1. Run: ./team1 status  (check service and container)"
    echo "    2. Run: ./team1 logs    (watch for error messages)"
    echo "    3. Run: ./team1 snapshot (test camera manually)"
    echo "    4. Check: ls -la ~/ultralytics/data/  (see saved files)"
    echo ""
}

# ── Command: Quick Overview ────────────────────────────────────────────────────
cmd_quick() {
    echo ""
    echo "${BOLD}═ Ultralytics YOLO — Quick Status ═${NC}"
    echo ""

    # System
    . /etc/os-release 2>/dev/null || true
    echo "  OS: ${PRETTY_NAME:-unknown}  |  Kernel: $(uname -r)  |  Arch: $(uname -m)"
    echo "  Memory: $(free -m | awk '/Mem:/ {print $3 "/" $2 "M used"}')  |  Disk: $(df -h "${HOME_DIR}" | awk 'NR==2 {print $3 "/" $2 " (" $5 ")"}')"
    if command -v vcgencmd &>/dev/null; then
        echo "  CPU: $(vcgencmd measure_temp 2>/dev/null || echo "?")  |  $(vcgencmd get_throttled 2>/dev/null || echo "")"
    fi
    echo ""

    # Camera
    video_devs=$(ls /dev/video* 2>/dev/null || true)
    echo "  Camera: $([ -n "$video_devs" ] && echo "✓ $(echo "$video_devs" | wc -w) device(s)" || echo "✗ not detected")"
    echo ""

    # Docker
    if command -v docker &>/dev/null; then
        echo "  Docker: ✓ $(docker --version 2>/dev/null | grep -oP '\S+ \S+' || true)"
        if docker ps --format '{{.Names}}' 2>/dev/null | grep -q "${CONTAINER_NAME}"; then
            echo "  Container: ✓ ${CONTAINER_NAME} ($(docker ps --filter "name=${CONTAINER_NAME}" --format '{{.Status}}'))"
        else
            echo "  Container: ✗ not running"
        fi
    else
        echo "  Docker: ✗ not installed"
    fi
    echo ""

    # Service
    if systemctl list-units --type=service --all 2>/dev/null | grep -q "${SERVICE_NAME}"; then
        echo "  Service: $(systemctl is-active "${SERVICE_NAME}" 2>/dev/null) | $(systemctl is-enabled "${SERVICE_NAME}" 2>/dev/null)"
    else
        echo "  Service: ✗ not found"
    fi
    echo ""

    # Results
    n_frames=$(ls -1 "${RESULTS_DIR}"/detect_*.jpg 2>/dev/null | wc -l)
    n_logs=$(wc -l < "${RESULTS_DIR}/detections.jsonl" 2>/dev/null || echo "0")
    echo "  Results: ${n_frames} image(s), ${n_logs} detection log(s)"
    data_size=$(du -sh "${RESULTS_DIR}" 2>/dev/null | cut -f1)
    echo "  Data size: ${data_size:-not created}"
    echo ""
}

# ── Command: Show Log Tails ────────────────────────────────────────────────────
cmd_logs() {
    echo ""
    echo "${BOLD}═ Service Logs (last 30 lines) ═${NC}"
    echo ""
    sudo journalctl -u "${SERVICE_NAME}" --no-pager -n 30 2>/dev/null || echo "  (no logs)"
    echo ""
    echo "${BOLD}═ Container Logs (last 20 lines) ═${NC}"
    echo ""
    docker logs "${CONTAINER_NAME}" --tail 20 2>/dev/null || echo "  (container not found)"
    echo ""
    echo "${BOLD}═ Detection Log (last 5 entries) ═${NC}"
    echo ""
    if [ -f "${RESULTS_DIR}/detections.jsonl" ]; then
        tail -5 "${RESULTS_DIR}/detections.jsonl" 2>/dev/null || true
    else
        echo "  (no detections yet)"
    fi
    echo ""
}

# ── Main ───────────────────────────────────────────────────────────────────────
usage() {
    echo "Usage: $0 [command]"
    echo ""
    echo "Commands:"
    echo "  (none)    Full diagnostics (all checks)"
    echo "  quick     Quick status overview"
    echo "  camera    Detailed camera diagnostics"
    echo "  docker    Docker-specific diagnostics"
    echo "  datadrive Data drive health check"
    echo "  logs      Show relevant log tails"
    echo "  fix       Suggest fixes for detected issues"
    echo "  --help    Show this help"
}

case "${1:-all}" in
    all)
        echo ""
        echo "  ╔═══════════════════════════════════════════════╗"
        echo "  ║  Ultralytics YOLO  —  Diagnostics & Support  ║"
        echo "  ╚═══════════════════════════════════════════════╝"
        echo ""
        echo "  ┌───────────────────────────────────────────────────┐"
        echo "  │  Available commands:                              │"
        echo "  │    $(printf "%-37s" "./support          → full diagnostics") │"
        echo "  │    $(printf "%-37s" "./support quick    → quick overview") │"
        echo "  │    $(printf "%-37s" "./support camera   → camera test") │"
        echo "  │    $(printf "%-37s" "./support docker   → Docker checks") │"
        echo "  │    $(printf "%-37s" "./support datadrive→ data drive check") │"
        echo "  │    $(printf "%-37s" "./support logs     → log tails") │"
        echo "  │    $(printf "%-37s" "./support fix      → suggested fixes") │"
        echo "  │    $(printf "%-37s" "./support --help   → all commands") │"
        echo "  └───────────────────────────────────────────────────┘"
        echo ""
        echo "  Timestamp: $(date)"
        echo "  User: ${USER}  |  Host: $(hostname)"
        echo ""
        check_system
        check_camera
        check_docker
        check_service
        check_model
        check_results
        check_data_drive
        check_network
        print_summary
        ;;
    quick)
        cmd_quick
        ;;
    camera)
        check_camera
        # Extra: try a test capture
        if docker ps --format '{{.Names}}' 2>/dev/null | grep -q "${CONTAINER_NAME}"; then
            echo ""
            log_info "Attempting test capture inside container..."
            docker exec "${CONTAINER_NAME}" pip uninstall -y picamera2 2>&1 > /dev/null || true
            if docker exec "${CONTAINER_NAME}" python3 -c "
import cv2, os, time
for dev in range(4):
    path = f'/dev/video{dev}'
    if not os.path.exists(path):
        continue
    cap = cv2.VideoCapture(path, cv2.CAP_V4L2)
    if not cap.isOpened():
        continue
    cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
    time.sleep(0.5)
    ret, frame = cap.read()
    cap.release()
    if ret:
        cv2.imwrite('/tmp/diag_capture.jpg', frame)
        print('OK')
        break
" 2>&1; then
                log_passed "Test capture succeeded"
            else
                log_failed "Test capture failed"
            fi
        fi
        ;;
    docker)
        check_docker
        check_service
        ;;
    datadrive)
        check_data_drive
        ;;
    logs)
        cmd_logs
        ;;
    fix)
        cmd_fix
        ;;
    --help|-h)
        usage
        ;;
    *)
        echo "Unknown command: $1"
        usage
        exit 1
        ;;
esac
