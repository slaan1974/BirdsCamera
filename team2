def _sec_label(s):
    """Format seconds as human label, e.g. 300 → '5min', 10 → '10s'."""
    return "%dmin" % (s // 60) if s >= 60 else "%ds" % s


def _class_filter_options(selected, action="/"):
    """Build <form> + <select> for class filter (native GET submission)."""
    options = [
        ("", "All"),
        ("person", "Person"),
        ("cat", "Cat"),
        ("bird", "Bird"),
    ]
    sel = 'selected'
    opts = ''.join(
        '<option value="%s" %s>%s</option>' % (v, sel if v == selected else "", l)
        for v, l in options
    )
    return ('<form method="GET" action="%s" class="filter-form">'
            '<select class="filter-select" name="class" onchange="this.form.submit()">'
            '%s</select></form>') % (action, opts)


class GalleryHandler(BaseHTTPRequestHandler):
    def do_GET(self):
        parsed = urlparse(self.path)
        path = parsed.path.rstrip("/") or "/"
        params = parse_qs(parsed.query)

        if path == "/":
            class_filter = params.get("class", [""])[0]
            self.send_index(class_filter=class_filter)
        elif path == "/gallery":
            oldest = params.get("view", [None])[0] == "oldest"
            class_filter = params.get("class", [""])[0]
            self.send_gallery(oldest=oldest, class_filter=class_filter)
        elif path == "/latest":
            self.send_latest()
        elif path == "/config":
            self.send_config()
        elif path.startswith("/download/"):
            name = path.split("/download/", 1)[1]
            self.send_download(name)
        elif path.startswith("/thumb/"):
            name = path.split("/thumb/", 1)[1]
            self.send_thumbnail(name)
        elif path.startswith("/image/"):
            name = path.split("/image/", 1)[1]
            self.send_image(name)
        else:
            self.send_error(404, "Not Found")

    def do_POST(self):
        parsed = urlparse(self.path)
        path = parsed.path.rstrip("/") or "/"
        if path == "/config":
            try:
                length = int(self.headers.get("Content-Length", 0))
                body = self.rfile.read(length).decode()
                cfg = json.loads(body)
                ok = save_gallery_config(cfg)
                if ok:
                    self.send_response(200)
                    self.send_header("Content-Type", "application/json")
                    self.end_headers()
                    self.wfile.write(b'{"ok": true}')
                else:
                    self.send_error(500, "Failed to write config")
            except Exception as e:
                self.send_error(400, f"Bad request: {e}")
        else:
            self.send_error(404, "Not Found")

    def send_config(self):
        cfg = load_gallery_config()
        # Add disk usage info
        try:
            st = os.statvfs(DATA_DIR)
            free_gb = st.f_frsize * st.f_bavail / (1024 ** 3)
            total_gb = st.f_frsize * st.f_blocks / (1024 ** 3)
            used_gb = total_gb - free_gb
        except Exception:
            free_gb = used_gb = total_gb = 0
        cfg["_disk"] = {
            "free_gb": round(free_gb, 1),
            "used_gb": round(used_gb, 1),
            "total_gb": round(total_gb, 1),
        }
        # Count current files
        n = len(list(Path(DATA_DIR).glob("detect_*.jpg")))
        cfg["_file_count"] = n
        resp = json.dumps(cfg).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(resp)))
        self.end_headers()
        self.wfile.write(resp)

    def send_index(self, class_filter=""):
        try:
            counts = load_counts()
            cards = self._detection_cards(limit=10, counts=counts,
                                          class_filter=class_filter)
            now = int(time.time())
            time_str = time.strftime("%Y-%m-%d %H:%M:%S")
            cfg = load_gallery_config()
            max_f = cfg.get("max_fifo", MAX_GALLERY)
            filter_html = _class_filter_options(class_filter, "/")
            class_qs = ("?class=" + class_filter) if class_filter else ""
            class_qs_amp = ("&class=" + class_filter) if class_filter else ""
            refresh_url = "/" + class_qs
            refresh_s = cfg.get("auto_refresh", 10)
            body = INDEX_HTML % {
                "ip": PI_IP,
                "port": PORT,
                "ts": now,
                "time": html.escape(time_str),
                "cards": cards,
                "max": max_f,
                "filter": filter_html,
                "class_qs": class_qs,
                "class_qs_amp": class_qs_amp,
                "refresh_url": html.escape(refresh_url),
                "refresh_ms": refresh_s * 1000,
                "refresh_label": _sec_label(refresh_s),
            }
            self._send_html(body)
        except Exception as e:
            import traceback
            traceback.print_exc()
            self.send_error(503, f"Gallery data not ready: {e}")

    def send_gallery(self, oldest=False, class_filter=""):
        cfg = load_gallery_config()
        max_f = cfg.get("max_fifo", MAX_GALLERY)
        files = sorted(Path(DATA_DIR).glob("detect_*.jpg"), reverse=not oldest)
        if class_filter:
            files = self._filter_by_class(files, class_filter)
        files = files[:max_f]
        if oldest:
            files = list(reversed(files))
        n_total = len(list(Path(DATA_DIR).glob("detect_*.jpg")))
        n_shown = len(files)
        title = "Oldest %d" % max_f if oldest else "Latest %d" % max_f
        stats = "%d image%s (FIFO, max %d)" % (
            n_total, "s" if n_total != 1 else "", max_f)
        counts = load_counts()
        cards = self._detection_cards(files=files, counts=counts)
        action = "/gallery?view=oldest" if oldest else "/gallery"
        filter_html = _class_filter_options(class_filter, action)
        qs_class_sep = "&" if class_filter else ""
        nav = '<a href="/">&larr; Live View</a>'
        if oldest:
            qs_class = ("?class=" + class_filter) if class_filter else ""
            nav += '  <a href="/gallery%s">&larr; Latest %d</a>' % (qs_class, max_f)
        else:
            qs_class = ("&class=" + class_filter) if class_filter else ""
            nav += '  <a href="/gallery?view=oldest%s">Oldest %d &rarr;</a>' % (qs_class, max_f)
        if oldest:
            refresh_url = "/gallery?view=oldest" + qs_class
        else:
            refresh_url = "/gallery" + (("?class=" + class_filter) if class_filter else "")
        refresh_s = cfg.get("auto_refresh", 10)
        body = GALLERY_HTML % {
            "title": html.escape(title),
            "stats": html.escape(stats),
            "nav": nav,
            "cards": cards,
            "filter": filter_html,
            "refresh_url": html.escape(refresh_url),
            "refresh_ms": refresh_s * 1000,
            "refresh_label": _sec_label(refresh_s),
        }
        self._send_html(body)

    @staticmethod
    def _filter_by_class(files, class_name):
        """Filter a list of file paths to only those containing class_name."""
        class_name = class_name.strip().lower()
        if not class_name or class_name == "all":
            return files
        idx = load_class_index()
        if not idx:
            return []
        return [f for f in files if class_name in [t.lower() for t in idx.get(f.name, [])]]

    def _detection_cards(self, files=None, limit=None, counts=None, class_filter=""):
        if counts is None:
            counts = {}
        if files is None:
            files = sorted(Path(DATA_DIR).glob("detect_*.jpg"), reverse=True)
            if class_filter:
                files = self._filter_by_class(files, class_filter)
            if limit:
                files = files[:limit]
        cards = []
        for f in files:
            label = html.escape(f.stem.replace("detect_", ""))
            name = html.escape(f.name)
            cnt, last_seen = counts.get(f.name, (1, ""))
            badge = ""
            if cnt > 1:
                badge = '<div class="count-badge">%s \u00d7%d</div>' % (
                    html.escape(f.stem.replace("detect_", "")[:12]), cnt)
            cards.append(
                '<div class="card">'
                + badge
                + '<img src="/thumb/%s" loading="lazy">'
                  % name
                + '<div class="card-body">'
                + '<div class="name">%s</div>' % label
                + '<div class="actions">'
                + '<a href="/image/%s">\U0001F50D View</a>' % name
                + '<a href="/download/%s">\u2B07 Download</a>' % name
                + "</div></div></div>"
            )
        if not cards:
            return '<p style="color:#555;">No detections yet. Point the camera at something!</p>'
        return '<div class="detection-grid">' + "\n".join(cards) + "</div>"

    def send_latest(self):
        if not os.path.isfile(LATEST_FILE):
            self.send_error(404, "No latest frame yet")
            return
        with open(LATEST_FILE, "rb") as f:
            data = f.read()
        self.send_response(200)
        self.send_header("Content-Type", "image/jpeg")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-cache, no-store, must-revalidate")
        self.send_header("Pragma", "no-cache")
        self.send_header("Expires", "0")
        self.end_headers()
        self.wfile.write(data)

    def send_image(self, name):
