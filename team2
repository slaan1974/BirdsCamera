    sudo systemctl daemon-reload
    sudo systemctl enable "${SERVICE_NAME}"
    sudo systemctl start "${SERVICE_NAME}"
    sudo systemctl enable "${GALLERY_SERVICE_NAME}"
    sudo systemctl start "${GALLERY_SERVICE_NAME}"
    info "Services '${SERVICE_NAME}' and '${GALLERY_SERVICE_NAME}' enabled (auto-start on boot)"
}

