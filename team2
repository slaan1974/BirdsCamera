#!/usr/bin/env bash
# ==============================================================================
# Ultralytics YOLO Team 2 — Wildlife Detection (Pi 4 + Camera v2)
# Raspberry Pi 4 + Pi Camera v2 — periodic capture, YOLO inference,
# class filter (person/cat/bird), web gallery with settings panel.
# NO Docker — runs natively on Pi OS.
# ==============================================================================
# Usage:
#   ./team2              Full setup (install deps, create venv, export model, enable service)
#   ./team2 wildlife     Run wildlife detection in foreground (testing)
#   ./team2 status       Show deployment status
#   ./team2 logs         Follow live inference logs
#   ./team2 gallery      Start web gallery for detection images (port 5000)
#   ./team2 snapshot     Capture a single test frame (via rpicam-jpeg)
#   ./team2 camera-test  Quick camera validation via rpicam-hello
#   ./team2 stop         Stop the service
#   ./team2 start        Start the service
#   ./team2 restart      Restart the service
# ==============================================================================
set -euo pipefail

# ── Force UTF-8 encoding ────────────────────────────────────────────────────────
# Pi OS defaults to ISO-8859-15, but Ultralytics logging uses emoji/unicode
# (U+1F680 rocket, U+2705 checkmark, U+26A0 warning, U+2014 em dash, etc.)
# Setting these prevents UnicodeEncodeError crashes in Python heredocs and
# the Ultralytics export pipeline.
export PYTHONIOENCODING=utf-8
export LC_ALL=C.UTF-8
export LANG=C.UTF-8

# ── Configuration ──────────────────────────────────────────────────────────────
PI_USER="${USER:-pi}"
HOME_DIR="/home/${PI_USER}"
BASE_DIR="${HOME_DIR}/ultralytics-local"
RESULTS_DIR="${BASE_DIR}/results"
MODELS_DIR="${BASE_DIR}/models"
TMPDIR_DIR="${BASE_DIR}/tmp"
MODEL_NAME="yolo26n"
VENV_DIR="${BASE_DIR}/venv"
SERVICE_NAME="ultralytics-wildlife.service"
GALLERY_SERVICE_NAME="ultralytics-gallery.service"
INFERENCE_SCRIPT="${BASE_DIR}/run_wildlife.py"
# Wildlife detection config (can be overridden via env when running)
CAPTURE_INTERVAL=5     # seconds between capture+inference cycles
TARGET_CLASSES="0"  # COCO class IDs: person(0), cat(15), bird(16)
GALLERY_SCRIPT="${BASE_DIR}/web_gallery.py"
SENTINEL_DIR="${BASE_DIR}/.setup"
SENTINEL_APT="${SENTINEL_DIR}/.apt_done"

# DATA_DRIVE — redirect results to exFAT partition (set DATA_DRIVE=true in env)
DATA_DRIVE_MOUNT="/mnt/wildlife-data"
DATA_DRIVE_SENTINEL=".wildlife_data_sentinel"
if [ "${DATA_DRIVE:-false}" = "true" ]; then
    RESULTS_DIR="${DATA_DRIVE_MOUNT}/team2"
fi

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

info()  { echo -e "${GREEN}$(date '+%Y-%m-%d %H:%M:%S') [${SCRIPT_NAME}] [INFO]${NC}  $1"; }
warn()  { echo -e "${YELLOW}$(date '+%Y-%m-%d %H:%M:%S') [${SCRIPT_NAME}] [WARN]${NC}  $1"; }
error() { echo -e "${RED}$(date '+%Y-%m-%d %H:%M:%S') [${SCRIPT_NAME}] [ERROR]${NC} $1" >&2; }

# ── Logging Setup ────────────────────────────────────────────────────────────
SCRIPT_NAME="team2"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOG_DIR="${SCRIPT_DIR}/logs"
mkdir -p "${LOG_DIR}"
LOG_FILE="${LOG_DIR}/$(date +%Y%m%d_%H%M%S)_${SCRIPT_NAME}.log"
exec > >(tee -a "${LOG_FILE}") 2>&1

# ── Pre-flight Checks ─────────────────────────────────────────────────────────
check_prereqs() {
    echo ""
    info "Checking prerequisites..."

    if [ "$(whoami)" = "root" ]; then
        error "Do not run as root. Run as the regular Pi user (e.g. pi)."
        exit 1
    fi
    info "User: $(whoami)"

    local arch
    arch=$(uname -m)
    if [ "$arch" = "aarch64" ]; then
        info "Architecture: ${arch} (ARM64)"
    else
        error "Expected aarch64, got ${arch}. This script is for Pi 4/5 64-bit OS."
        exit 1
    fi

    if ! ls /dev/video* &>/dev/null; then
        error "No /dev/video* devices found. Connect and enable the camera:"
        error "  sudo raspi-config  → Interface Options → Camera → Enable → Reboot"
        exit 1
    fi
    info "Camera devices: $(ls /dev/video* 2>/dev/null | tr '\n' ' ')"

    if command -v rpicam-hello &>/dev/null; then
        info "rpicam-hello found: $(rpicam-hello --version 2>&1 | head -1 || echo 'available')"
    else
        warn "rpicam-hello not found — install: sudo apt install rpicam-apps"
    fi

    info "All prerequisites met"
}

# ── Directory Setup ────────────────────────────────────────────────────────────
setup_dirs() {
    echo ""
    info "Setting up directories..."
    mkdir -p "${RESULTS_DIR}" "${MODELS_DIR}"
    info "Base:       ${BASE_DIR}"
    info "Models:     ${MODELS_DIR}"
    info "Results:    ${RESULTS_DIR}"
}

# ── Data Drive Setup (when DATA_DRIVE=true) ─────────────────────────────────
setup_data_drive() {
    if [ "${DATA_DRIVE:-false}" != "true" ]; then
        return
    fi
    echo ""
    info "Data drive mode enabled (DATA_DRIVE=true)"

    if ! mountpoint -q "${DATA_DRIVE_MOUNT}" 2>/dev/null; then
        warn "${DATA_DRIVE_MOUNT} is not mounted"
        warn "  Run ./setup-data-drive.sh sd first, or mount the exFAT partition manually"
        warn "  Falling back to default results directory"
        RESULTS_DIR="${BASE_DIR}/results"
        return
    fi

    if [ ! -f "${DATA_DRIVE_MOUNT}/${DATA_DRIVE_SENTINEL}" ]; then
        warn "Sentinel file '${DATA_DRIVE_SENTINEL}' not found on ${DATA_DRIVE_MOUNT}"
        warn "  Run ./setup-data-drive.sh sd to initialise the data partition"
        warn "  Falling back to default results directory"
        RESULTS_DIR="${BASE_DIR}/results"
        return
    fi

    mkdir -p "${RESULTS_DIR}"
    local nframes
    nframes=$(ls -1 "${RESULTS_DIR}"/detect_*.jpg 2>/dev/null | wc -l)
    info "Data drive: ${DATA_DRIVE_MOUNT} (${nframes} existing detection files)"
}

# ── Install System Dependencies & Python Venv ─────────────────────────────────
install_deps() {
    if [ -f "${SENTINEL_APT}" ]; then
        info "System dependencies already installed (delete ${SENTINEL_APT} or use --force to redo)"
        source "${VENV_DIR}/bin/activate" 2>/dev/null || true
        return
    fi
    echo ""
    info "Installing system packages..."
    sudo apt update
    sudo apt install -y python3-pip python3-venv python3-picamera2 \
        libgl1 libglib2.0-0 rpicam-apps libcap-dev

    echo ""
    info "Creating pip temp directory on SD card (not tmpfs)..."
    mkdir -p "${TMPDIR_DIR}"
    export TMPDIR="${TMPDIR_DIR}"

    info "Creating Python virtual environment (with system packages for picamera2/libcamera)..."
    # --system-site-packages is required because libcamera (a picamera2 dependency)
    # is only available as an apt package (python3-libcamera), not on pip.
    python3 -m venv --system-site-packages "${VENV_DIR}"
    source "${VENV_DIR}/bin/activate"

    info "Upgrading pip..."
    pip install -U pip

    info "Installing CPU-only PyTorch for Pi 4 (avoid Jetson CUDA builds)..."
    # Clear any cached CUDA torch wheels — these crash on Pi 4 with "Illegal instruction"
    pip cache remove torch* 2>/dev/null || true
    # Use CPU-only index exclusively. CUDA builds (+cuNNN) contain x86-specific
    # instructions (AVX/AVX2/FMA) that the Cortex-A72 doesn't support.
    pip install torch torchvision --index-url https://download.pytorch.org/whl/cpu \
        --no-cache-dir --force-reinstall

    # Verify we got a CPU build; CUDA builds will crash at export/inference time
    info "Verifying PyTorch build..."
    python3 -c "
import torch, sys
v = torch.__version__
if 'cu' in v:
    print(f'ERROR: got CUDA build ({v}) instead of CPU build — will crash on Pi 4')
    print('Falling back to pinned version with known aarch64 support...')
    sys.exit(1)
print(f'PyTorch {v} (CPU) OK')
" || {
        warn "CPU index did not provide aarch64 wheels for latest version, trying 2.4.0..."
        pip install torch==2.4.0 torchvision==0.19.0 \
            --index-url https://download.pytorch.org/whl/cpu \
            --no-cache-dir --force-reinstall
        python3 -c "
import torch
v = torch.__version__
assert 'cu' not in v, f'Still got CUDA build: {v}'
print(f'PyTorch {v} (CPU) OK')
"
    }

    info "Installing Ultralytics with export dependencies..."
    pip install ultralytics[export]
    # Fix: portalocker required by ncnn; send2trash needs --ignore-installed
    # to override the buggy system package in /usr/lib/python3/dist-packages
    pip install portalocker
    pip install "send2trash>=1.8.2,<2.0.0" --ignore-installed

    info "Cleaning up pip cache and temp files..."
    pip cache purge
    rm -rf "${TMPDIR_DIR:?}"/*
    mkdir -p "${SENTINEL_DIR}"
    touch "${SENTINEL_APT}"
    info "Dependencies installed"
}

# ── Export NCNN Model ──────────────────────────────────────────────────────────
export_model() {
    echo ""
    info "Exporting YOLO${MODEL_NAME#yolo} to NCNN (may take 5-15 min on Pi 4)..."
    source "${VENV_DIR}/bin/activate"
    export TMPDIR="${TMPDIR_DIR}"

    python3 << PYEOF
import os, shutil
from ultralytics import YOLO

model = YOLO("${MODEL_NAME}.pt")
model.export(format="ncnn", imgsz=320)

# Model is saved by Ultralytics to the current working directory
cwd = os.getcwd()
src = os.path.join(cwd, "${MODEL_NAME}_ncnn_model")
dst = os.path.expanduser("${MODELS_DIR}/${MODEL_NAME}_ncnn_model")

if os.path.isdir(src):
    if os.path.isdir(dst):
        shutil.rmtree(dst)
    shutil.move(src, dst)
    print(f"Model moved to {dst}")
else:
    # Fallback: check home dir (some Ultralytics versions save there)
    alt = os.path.expanduser("~/${MODEL_NAME}_ncnn_model")
    if os.path.isdir(alt):
        if os.path.isdir(dst):
            shutil.rmtree(dst)
        shutil.move(alt, dst)
        print(f"Model moved from {alt} to {dst}")
    else:
        print(f"Model directory not found at {src} or {alt}")
        print(f"Contents of CWD: {os.listdir(cwd)}")
        dirs = [d for d in os.listdir(cwd) if d.endswith("_ncnn_model")]
        if dirs:
            print(f"Found NCNN model dirs in CWD: {dirs}")
        raise FileNotFoundError(f"Cannot find exported NCNN model: ${MODEL_NAME}_ncnn_model")
PYEOF

    info "Model exported to ${MODELS_DIR}/${MODEL_NAME}_ncnn_model"
}

# ── Create Inference Script ────────────────────────────────────────────────────
create_inference_script() {
    echo ""
    info "Creating inference script..."

    cat > "${INFERENCE_SCRIPT}" << 'PYEOF'
#!/usr/bin/env python3
"""Wildlife detection — Pi 4 + Camera v2.

Captures a frame every CAPTURE_INTERVAL seconds, runs YOLO inference,
and filters for target classes (default: person, cat, bird).
Saves annotated image + JSONL entry only when targets are detected.
Frames with no matching detections are silently discarded.

All settings have defaults and can be overridden via config.json
(written by web gallery settings panel at runtime) or env vars.

Environment variables (all optional):
  CAPTURE_INTERVAL=N  Seconds between capture+inference cycles (default: 5)
  CONF_THRESH=N       Confidence threshold (default: 0.25)
  IOU_THRESH=N        IoU threshold (default: 0.45)
  IMGSZ=N             Inference image size (default: 320)
  TARGET_CLASSES=N    Comma-separated COCO class IDs (default: 0,15,16)
  MAX_FIFO=N          Max saved images before oldest deleted (default: 1000)
  MIN_FREE_SPACE_GB=N Minimum free space to keep on device (default: 1)
"""

import os
import sys
import time
import json
import signal
import logging
import glob

import cv2
from picamera2 import Picamera2
from ultralytics import YOLO

# ── Config file (shared with web gallery) ──────────────────────────────────
CONFIG_FILE = os.path.join(os.path.expanduser("~"),
                           "ultralytics-local", "results", "config.json")
CONFIG_DEFAULTS = {
    "capture_interval": 5,
    "auto_refresh": 10,
    "max_fifo": 1000,
    "min_free_space_gb": 1,
    "target_classes": [0],
    "camera_resolution": "1920x1080",
}


def load_config():
    """Read config.json, falling back to env vars / defaults."""
    cfg = dict(CONFIG_DEFAULTS)
    if os.path.isfile(CONFIG_FILE):
        try:
            with open(CONFIG_FILE) as f:
                cfg.update(json.load(f))
        except Exception:
            pass
    # Env vars override file (for systemd / manual override)
    cfg["capture_interval"] = int(os.environ.get("CAPTURE_INTERVAL", cfg["capture_interval"]))
    cfg["max_fifo"] = int(os.environ.get("MAX_FIFO", cfg["max_fifo"]))
    cfg["min_free_space_gb"] = float(os.environ.get("MIN_FREE_SPACE_GB", cfg["min_free_space_gb"]))
    env_classes = os.environ.get("TARGET_CLASSES")
    if env_classes:
        cfg["target_classes"] = [int(x) for x in env_classes.split(",")]
    return cfg


def write_default_config():
    """Write default config.json if it doesn't exist."""
    if not os.path.isfile(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "w") as f:
                json.dump(CONFIG_DEFAULTS, f, indent=2)
            log.info("Wrote default config → %s", CONFIG_FILE)
        except Exception as e:
            log.warning("Could not write default config: %s", e)

# ── Venv path (when running via systemd) ──
VENV_SITE = os.path.expanduser("~/ultralytics-local/venv/lib/python3.*/site-packages")
site_pkg = glob.glob(VENV_SITE)
if site_pkg and site_pkg[0] not in sys.path:
    sys.path.insert(0, site_pkg[0])

# ── Configuration ──────────────────────────────────────────────────────────────
HOME = os.path.expanduser("~")
MODEL_PATH  = os.path.join(HOME, "ultralytics-local", "models", "yolo26n_ncnn_model")
OUTPUT_DIR  = os.path.join(HOME, "ultralytics-local", "results")
CONF_THRESH = float(os.environ.get("CONF_THRESH", "0.25"))
IOU_THRESH  = float(os.environ.get("IOU_THRESH", "0.45"))
IMGSZ       = int(os.environ.get("IMGSZ", "320"))

# Load dynamic config from config.json (overridable via env)
CFG = load_config()

# Fallback labels if model.names doesn't resolve (shouldn't happen with COCO)
TARGET_NAMES = {0: "person", 15: "cat", 16: "bird"}

running = True
cam = None

def signal_handler(signum, frame):
    global running
    logging.info("Received signal %d, shutting down...", signum)
    running = False

signal.signal(signal.SIGTERM, signal_handler)
signal.signal(signal.SIGINT, signal_handler)

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(message)s",
    datefmt="%Y-%m-%d %H:%M:%S",
)
log = logging.getLogger("wildlife")

# ── Camera Initialisation ──────────────────────────────────────────────────────

def _build_config(picam2, resolution):
    """Return a picamera2 configuration for the given resolution string."""
    if resolution == "3280x2464":
        return picam2.create_still_configuration(
            main={"size": (3280, 2464), "format": "RGB888"},
        )
    return picam2.create_preview_configuration(
        main={"size": (1920, 1080), "format": "RGB888"},
    )


def init_camera(resolution="1920x1080"):
    for attempt in range(5):
        picam2 = None
        try:
            picam2 = Picamera2()
            config = _build_config(picam2, resolution)
            picam2.configure(config)
            picam2.start()
            time.sleep(2)
            log.info("Camera initialised (picamera2) — %s", resolution)
            return picam2
        except Exception as e:
            log.warning("Camera init attempt %d/5 failed: %s", attempt + 1, e)
            if picam2 is not None:
                try:
                    picam2.close()
                except Exception:
                    pass
            time.sleep(2)
    raise RuntimeError("Could not initialise camera after 5 attempts")

# ── FIFO cleanup ───────────────────────────────────────────────────────────────

def fifo_cleanup(output_dir, max_entries, min_free_gb=1):
    """Remove oldest entries until count <= max_entries AND free space >= min_free_gb."""
    det_log = os.path.join(output_dir, "detections.jsonl")
    if not os.path.isfile(det_log):
        return
    with open(det_log) as f:
        entries = [json.loads(line) for line in f if line.strip()]
    if not entries:
        return

    # Keep removing oldest until both conditions satisfied
    while len(entries) > max_entries:
        removed = entries.pop(0)
        _remove_entry(output_dir, removed)

    # Enforce free space floor
    free_gb = _free_space_gb(output_dir)
    while entries and free_gb < min_free_gb:
        removed = entries.pop(0)
        _remove_entry(output_dir, removed)
        free_gb = _free_space_gb(output_dir)

    # Rewrite JSONL with remaining entries
    with open(det_log, "w") as f:
        for e in entries:
            f.write(json.dumps(e, sort_keys=True) + "\n")


def _remove_entry(output_dir, entry):
    fname = entry.get("frame_file", "")
    if fname:
        fpath = os.path.join(output_dir, fname)
        if os.path.isfile(fpath):
            os.remove(fpath)
            log.info("FIFO removed %s", fname)


def _free_space_gb(path):
    try:
        st = os.statvfs(path)
        return st.f_frsize * st.f_bavail / (1024 ** 3)
    except Exception:
        return 999  # assume plenty on error

# ── Main Loop ──────────────────────────────────────────────────────────────────

def wait_interval(seconds):
    """Sleep for `seconds` seconds, checking `running` every 1s."""
    for _ in range(int(seconds)):
        if not running:
            break
        time.sleep(1)


def reconfig():
    """Reload config from config.json into the global CFG.
    Reconfigures existing camera if camera_resolution changed.
    """
    global CFG, cam
    old_res = CFG.get("camera_resolution", "1920x1080")
    CFG = load_config()
    new_res = CFG.get("camera_resolution", "1920x1080")
    if new_res != old_res:
        log.info("DIAG: resolution change detected %s → %s", old_res, new_res)
        if cam is not None:
            log.info("DIAG: reconfig — stopping camera")
            try:
                cam.stop()
                log.info("DIAG: reconfig — camera stopped OK")
            except Exception as e:
                log.warning("DIAG: reconfig — cam.stop() exception: %s", e)
            try:
                cam.close()
            except Exception:
                pass
            cam = None
        else:
                log.info("DIAG: reconfig — cam is None, skipping stop/close")
        new_cam = None
        try:
            log.info("DIAG: reconfig — creating new Picamera2")
            new_cam = Picamera2()
            config = _build_config(new_cam, new_res)
            log.info("DIAG: reconfig — configuring camera")
            new_cam.configure(config)
            log.info("DIAG: reconfig — configured OK")
            log.info("DIAG: reconfig — starting camera")
            new_cam.start()
            log.info("DIAG: reconfig — started OK, sleeping 2s")
            time.sleep(2)
            log.info("DIAG: reconfig — warm-up capture")
            try:
                warm = new_cam.capture_array()
                log.info("DIAG: reconfig — warm-up frame shape=%s", warm.shape)
            except Exception as e:
                log.warning("DIAG: reconfig — warm-up capture failed: %s", e)
            cam = new_cam
            log.info("Camera reconfigured — %s", new_res)
        except Exception as e:
            log.error("DIAG: reconfig — FAILED: %s", e, exc_info=True)
            if new_cam is not None:
                try:
                    new_cam.close()
                except Exception:
                    pass
            raise
    return CFG


def main():
    global running, CFG, cam

    os.makedirs(OUTPUT_DIR, exist_ok=True)
    detections_log = os.path.join(OUTPUT_DIR, "detections.jsonl")
    write_default_config()

    log.info("Loading model from %s", MODEL_PATH)
    model = YOLO(MODEL_PATH)
    log.info("Model loaded")

    cfg = reconfig()
    target_labels = [model.names.get(c, TARGET_NAMES.get(c, str(c)))
                     for c in cfg["target_classes"]]
    log.info("Wildlife detection started (capture every %ds, targets: %s)",
             cfg["capture_interval"], target_labels)

    cam = init_camera(cfg.get("camera_resolution", "1920x1080"))
    saved_count = 0
    iter_count = 0

    while running:
        # Reload config periodically for responsive UI
        iter_count += 1
        if iter_count % 5 == 0:
            cfg = reconfig()

        try:
            frame = cam.capture_array()
            log.info("DIAG: loop — frame shape=%s dtype=%s", frame.shape, frame.dtype)
        except Exception as e:
            log.error("DIAG: loop — capture_array() failed: %s", e, exc_info=True)
            time.sleep(1)
            if cam is not None:
                try:
                    cam.stop()
                except Exception:
                    pass
                try:
                    cam.close()
                except Exception:
                    pass
                cam = None
            time.sleep(1)
            cam = init_camera(CFG.get("camera_resolution", "1920x1080"))
            log.info("DIAG: loop — camera reinitialised after capture failure")
            continue

        log.info("DIAG: loop — model inference starting (frame=%s)", frame.shape)
        results = model(frame, imgsz=IMGSZ, conf=CONF_THRESH,
                        iou=IOU_THRESH, verbose=False)
        log.info("DIAG: loop — inference done")

        # Annotate frame (always — for latest.jpg live view)
        try:
            annotated = results[0].plot()
            log.info("DIAG: loop — plot() OK, annotated shape=%s", annotated.shape)
        except Exception as e:
            log.warning("DIAG: loop — plot() failed: %s, using raw frame", e)
            annotated = frame

        ts_str = time.strftime("%Y-%m-%d %H:%M:%S")
        cv2.putText(annotated, ts_str, (10, annotated.shape[0] - 10),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 255, 0), 2)

        # Always save latest.jpg for the web gallery Live View
        latest_path = os.path.join(OUTPUT_DIR, "latest.jpg")
        if not cv2.imwrite(latest_path, annotated):
            log.warning("DIAG: loop — FAILED to write latest.jpg")
        else:
            sz = os.path.getsize(latest_path)
            log.info("DIAG: loop — wrote latest.jpg (%d bytes)", sz)

        dets = results[0].boxes
        has_detections = dets is not None and len(dets) > 0

        if not has_detections:
            log.debug("No detections — discarding")
            wait_interval(cfg["capture_interval"])
            continue

        cls_ids = [int(c) for c in dets.cls.tolist()]
        confs = [f"{c:.2f}" for c in dets.conf.tolist()]

        # Filter to only target classes
        matched_indices = [i for i, c in enumerate(cls_ids) if c in cfg["target_classes"]]

        if not matched_indices:
            log.debug("No target classes detected — discarding")
            wait_interval(cfg["capture_interval"])
            continue

        # Save annotated image with timestamp in filename
        ts_file = time.strftime("%Y%m%d_%H%M%S")
        fname = f"detect_{ts_file}.jpg"
        fpath = os.path.join(OUTPUT_DIR, fname)
        cv2.imwrite(fpath, annotated)

        # Build JSONL entry
        matched_classes = [
            model.names.get(cls_ids[i], TARGET_NAMES.get(cls_ids[i], str(cls_ids[i])))
            for i in matched_indices
        ]
        matched_confs = [confs[i] for i in matched_indices]

        entry = {
            "timestamp": ts_str,
            "frame_file": fname,
            "targets": matched_classes,
            "confidences": matched_confs,
            "class_ids": [cls_ids[i] for i in matched_indices],
        }
        with open(detections_log, "a") as f:
            f.write(json.dumps(entry, sort_keys=True) + "\n")

        log.info("SAVED %s  targets: %s", fname, matched_classes)
        saved_count += 1

        # FIFO cleanup (count + free space)
        fifo_cleanup(OUTPUT_DIR, cfg["max_fifo"], min_free_gb=cfg["min_free_space_gb"])

        wait_interval(cfg["capture_interval"])

    log.info("Shutdown — %d detection images saved", saved_count)
    if cam is not None:
        try:
            cam.stop()
        except Exception:
            pass
        try:
            cam.close()
        except Exception:
            pass
    cv2.destroyAllWindows()

if __name__ == "__main__":
    main()
