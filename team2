# ── Stop / Start / Restart ──────────────────────────────────────────────────────
cmd_stop() {
    echo "Stopping services..."
    sudo systemctl stop "${SERVICE_NAME}"
    sudo systemctl stop "${GALLERY_SERVICE_NAME}"
    echo "Services stopped"
}

cmd_start() {
    echo "Starting services..."
    sudo systemctl start "${SERVICE_NAME}"
    sudo systemctl start "${GALLERY_SERVICE_NAME}"
    echo "Services started"
    sleep 2
    cmd_status
}

cmd_restart() {
    echo "Restarting services..."
    sudo systemctl restart "${SERVICE_NAME}"
    sudo systemctl restart "${GALLERY_SERVICE_NAME}"
    echo "Services restarted"
    sleep 2
    cmd_status
}

# ── Snapshot (via rpicam-jpeg, works over SSH) ──
cmd_snapshot() {
    echo ""
    info "Capturing a single test frame via rpicam-jpeg..."

    if ! command -v rpicam-jpeg &>/dev/null; then
        error "rpicam-jpeg not found. Install: sudo apt install rpicam-apps"
        exit 1
    fi

    local output="${RESULTS_DIR}/snapshot.jpg"
    mkdir -p "${RESULTS_DIR}"

    # --nopreview works without display (important for SSH)
    # --timeout 2000 = 2 seconds for auto-exposure to settle
    if rpicam-jpeg --output "${output}" --timeout 2000 --width 640 --height 480 --nopreview 2>&1; then
        if [ -f "${output}" ]; then
            local size
            size=$(du -h "${output}" | cut -f1)
            info "Saved → ${output} (${size})"
            # Also copy to /tmp for remote retrieval
            cp "${output}" /tmp/team2_snapshot.jpg
            info "Also available at /tmp/team2_snapshot.jpg (for scp)"
        else
            error "rpicam-jpeg finished but no output file found"
            exit 1
        fi
    else
        error "Snapshot failed. Check camera connection."
        error "  Run: rpicam-hello --nopreview --timeout 2000  (to test camera)"
        exit 1
    fi
}

# ── Camera Test (via rpicam-hello, no display needed) ──
cmd_camera_test() {
    echo ""
    info "Running camera test via rpicam-hello..."

    if ! command -v rpicam-hello &>/dev/null; then
        error "rpicam-hello not found. Install: sudo apt install rpicam-apps"
        exit 1
    fi

    echo ""
    echo "  Camera test: rpicam-hello --nopreview --timeout 2000"
    echo "  (No preview window — tests camera hardware/driver only)"
    echo ""

    # --nopreview suppresses the display window, works over SSH
    if rpicam-hello --nopreview --timeout 2000 2>&1; then
        info "Camera test PASSED — sensor detected and operational"
        echo ""
        # Show sensor info
        rpicam-hello --nopreview --timeout 500 --info-text \
            "  Sensor: %sensor  |  Size: %width x %height  |  Gain: %rg / %bg" 2>&1 || true
    else
        error "Camera test FAILED"
        error "  Check: sudo raspi-config → Interface Options → Camera → Enable"
        error "  Check: rpicam-hello -t 2000  (on desktop with display)"
        exit 1
    fi
}

