          var d = cfg._disk;
          document.getElementById('cfg_diskinfo').textContent =
            d.used_gb + 'G used / ' + d.free_gb + 'G free / ' + d.total_gb + 'G total';
        }
      }).catch(function(){
        document.getElementById('cfg_diskinfo').textContent = '(error loading config)';
      });
