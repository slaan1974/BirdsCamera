# ── Detect Pi's IP address ──────────────────────────────────────────────────
def get_ip():
    for method in (
        lambda: subprocess.check_output(["hostname", "-I"], text=True).split()[0],
        lambda: socket.gethostbyname(socket.gethostname()),
    ):
        try:
            ip = method()
            if ip and not ip.startswith("127."):
                return ip
        except Exception:
            pass
    return "<pi-ip>"

PI_IP = get_ip()

# ── Load dedup count info from JSONL ────────────────────────────────────────
def load_counts():
    """Return dict mapping frame_file -> (count, last_seen)."""
    counts = {}
    if not os.path.isfile(JSONL_FILE):
        return counts
    try:
        with open(JSONL_FILE) as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    entry = json.loads(line)
                except json.JSONDecodeError:
                    continue
                ff = entry.get("frame_file", "")
                if ff:
                    counts[ff] = (entry.get("count", 1), entry.get("last_seen", ""))
    except Exception:
        pass
    return counts

# ── Config file (shared with inference) ────────────────────────────────────
CONFIG_FILE = os.path.join(DATA_DIR, "config.json")

def load_gallery_config():
    """Return dict with capture_interval, max_fifo, min_free_space_gb, camera_resolution."""
    cfg = {"capture_interval": 5, "auto_refresh": 10, "max_fifo": 1000,
           "min_free_space_gb": 1, "camera_resolution": "1920x1080"}
    if os.path.isfile(CONFIG_FILE):
        try:
            with open(CONFIG_FILE) as f:
                cfg.update(json.load(f))
        except Exception:
            pass
    return cfg

def save_gallery_config(cfg):
    """Write config.json (atomic write via tmp + rename)."""
    tmp = CONFIG_FILE + ".tmp"
    try:
        with open(tmp, "w") as f:
            json.dump(cfg, f, indent=2)
        os.rename(tmp, CONFIG_FILE)
        return True
    except Exception:
        try:
            if os.path.isfile(tmp):
                os.remove(tmp)
        except Exception:
            pass
        return False

# ── Load JSONL into per-file class index ──────────────────────────────────
def load_class_index():
    """Return dict mapping frame_file -> list of target class names.
    Handles both new format ({"targets": ["cat","person"]}) and
    old format ({"class": "motorcycle,car"}).
    """
    idx = {}
    if not os.path.isfile(JSONL_FILE):
        return idx
    try:
        with open(JSONL_FILE) as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    entry = json.loads(line)
                except json.JSONDecodeError:
                    continue
                ff = entry.get("frame_file", "")
                if not ff:
                    continue
                # New format: "targets" is a list
                targets = entry.get("targets")
                if targets and isinstance(targets, list):
                    idx[ff] = targets
                    continue
                # Old format: "class" is a string (possibly comma-separated)
                cls = entry.get("class")
                if cls and isinstance(cls, str):
                    idx[ff] = [c.strip() for c in cls.split(",")]
    except Exception:
        pass
    return idx

