    echo ""
    echo "── Services ──"
    sudo systemctl status "${SERVICE_NAME}" --no-pager 2>&1 | head -12
    echo ""
    sudo systemctl status "${GALLERY_SERVICE_NAME}" --no-pager 2>&1 | head -12
    echo ""
    echo "── Model ──"
    if [ -d "${MODELS_DIR}/${MODEL_NAME}_ncnn_model" ]; then
        echo "  Model: ${MODELS_DIR}/${MODEL_NAME}_ncnn_model ✓"
    else
        echo "  Model: not found (run ./team2 to export)"
    fi
    echo ""
    echo "── Results ──"
    if [ -d "${RESULTS_DIR}" ]; then
        echo "  Directory: ${RESULTS_DIR}"
        nframes=$(ls -1 "${RESULTS_DIR}"/detect_*.jpg 2>/dev/null | wc -l)
        ndets=$(wc -l < "${RESULTS_DIR}/detections.jsonl" 2>/dev/null || echo "0")
        # Sum dedup counts from JSONL for approximate real detection count
        dedup_total=$(python3 -c "
import json, sys
f = '${RESULTS_DIR}/detections.jsonl'
try:
    with open(f) as fh:
        print(sum(json.loads(l).get('count', 1) for l in fh if l.strip()))
except Exception:
    print(0)
" 2>/dev/null || echo "?")
        echo "  Saved frames: ${nframes}  (FIFO max 1000)"
        echo "  JSONL entries: ${ndets}"
        echo "  Dedup-adjusted detections: ${dedup_total}"
        echo ""
        echo "  Last 3 entries:"
        if [ -f "${RESULTS_DIR}/detections.jsonl" ] && [ "$(wc -l < "${RESULTS_DIR}/detections.jsonl")" -gt 0 ]; then
            tail -3 "${RESULTS_DIR}/detections.jsonl" | while IFS= read -r line; do
                echo "    $(echo "$line" | python3 -m json.tool 2>/dev/null || echo "$line")"
            done
        else
            echo "    (none yet)"
        fi
    else
        echo "  Directory ${RESULTS_DIR} not found"
    fi
    echo ""
    echo "── Live Feed ──"
    latest_path="${RESULTS_DIR}/latest.jpg"
    if [ -f "$latest_path" ]; then
        now_epoch=$(date +%s)
        file_mtime=$(stat -c %Y "$latest_path" 2>/dev/null || echo "0")
        age=$((now_epoch - file_mtime))
        if [ "$age" -lt 60 ]; then
            echo "  latest.jpg: ${age}s old \u2713"
        else
            echo "  latest.jpg: ${age}s old \u26A0 (stale \u2014 inference may be down)"
        fi
    else
        echo "  latest.jpg: not found (inference may not have processed a frame yet)"
    fi
    echo ""
    echo "── Camera ──"
    if command -v rpicam-hello &>/dev/null; then
        echo "  rpicam-hello: available"
    else
        echo "  rpicam-hello: not installed"
    fi
    video_devs=$(ls /dev/video* 2>/dev/null || true)
    echo "  Video devices: $([ -n "$video_devs" ] && echo "$(echo "$video_devs" | wc -w) found" || echo "none")"
    echo ""
    echo "════════════════════════════════════════════════════════════════"
}

