    echo "  setup --force  Full setup, redo all steps (re-install deps, re-export model)"
    echo "  status       Show deployment status (inference + gallery)"
    echo "  logs         Follow live inference logs (Ctrl+C to exit)"
    echo "  wildlife     Run wildlife detection in foreground (for testing)"
    echo "  gallery      Start web gallery for detection images (port 5000)"
    echo "  snapshot     Capture a single test frame (via rpicam-jpeg)"
    echo "  camera-test  Quick camera validation (via rpicam-hello)"
