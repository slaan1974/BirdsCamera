        document.getElementById('cfg_maxfifo').value = cfg.max_fifo || 1000;
        document.getElementById('cfg_minfree').value = cfg.min_free_space_gb || 1;
        document.getElementById('cfg_resolution').value = cfg.camera_resolution || '1920x1080';
        document.getElementById('cfg_auto_refresh').value = cfg.auto_refresh || 10;
