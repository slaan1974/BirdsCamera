"""Web gallery for Team 2 — live camera view + dedup-aware FIFO gallery.

Serves on http://<pi-ip>:5000.

Endpoints:
  /                     Main page: live view + last 10 detections (5s refresh)
  /gallery              Latest 1000 detection images (10s refresh)
  /gallery?view=oldest  Oldest 1000 detection images (10s refresh)
  /latest               Most recent camera frame (annotated, no-cache)
  /image/{name}         Full-size detection image
  /download/{name}      Detection image with Content-Disposition (save dialog)
"""
import os
import re
import json
import html
import base64
import socket
import subprocess
