    info "Restarting services to apply changes..."
    sudo systemctl daemon-reload
    sudo systemctl restart "${SERVICE_NAME}" "${GALLERY_SERVICE_NAME}" 2>/dev/null || true
    info "Update complete!"
    cmd_status
}

